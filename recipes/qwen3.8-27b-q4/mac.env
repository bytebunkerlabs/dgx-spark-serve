# qwen3.8-27b-q4 on a Mac: llama.cpp b11430 with Metal, ggml-org's Q4_K_M (19.0 GB), the baseline for qwen3.8-27b-tf:
# the same window and streams, no drafts, text only. The day-to-day recipe is qwen3.8-27b.
WEIGHTS_GB=19.0
ENGINE=llamacpp
. "$RECIPE_DIR/model.env"
ARTIFACT=ggml-org/Qwen3.8-27B-GGUF/Qwen3.8-27B-Q4_K_M.gguf
ARTIFACT_REVISION=71bc7b627595dc8a91039addd9c791ae548d6747
SERVE_ARGS=(
  # 4 SHAPE   the same as qwen3.8-27b-tf's: a 65536-token window, 4 streams at once
  --n-gpu-layers 999
  --ctx-size 65536
  --parallel 4
  --kv-unified                   # one cache for the 4 slots: any one request may use all 65536
  # 5 DIALECT
  --jinja
  --reasoning-format deepseek
)
ENV_EXTRA=()
# 8 PROOF   bench/results.jsonl, labels qwen3.8-27b-q4-*
