# nemotron-3.5-lightning-tf on a Mac: TensorFold 0.6.6 (MLX), NVIDIA Nemotron 3.5
# Lightning 30B-A3B (a hybrid Mamba-Transformer MoE, 3B active), drafts on with
# the checkpoint's own MTP layer. Built for speed: few active weights a token,
# and Mamba layers keep long prompts cheap.
#
# 1 FIT     MLX 4-bit, groups of 64, with the MTP layer: 18.5 GB. Fits from a
#           36 GB Mac with a 65536-token window.
WEIGHTS_GB=18.5
# 2 ENGINE  TensorFold at rack's pinned commit, in its own venv.
ENGINE=tensorfold
# 3 ACCESS  TensorFold's checkpoint (mtp-4bit.safetensors beside the weights), pinned.
. "$RECIPE_DIR/model.env"
ARTIFACT=TensorFold/NVIDIA-Nemotron-3.5-Lightning-30B-A3B-MLX-4bit
ARTIFACT_REVISION=d9d758fb83953437f7263256b0d96157e2a348b8
SERVE_ARGS=(
  # 4 SHAPE   rack up sets --host, --port, --name, --api-key-file, --no-update-check.
  --context 65536
  --parallel 4
  # 6 SPEED   MTP drafts on by default; --no-drafts: one token a round
)
ENV_EXTRA=()
# 8 PROOF   not yet benched: rack up nemotron-3.5-lightning-tf --mac && rack bench nemotron-3.5-lightning-tf
