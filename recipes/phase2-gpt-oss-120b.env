# Phase 2 — the distribution experiment. gpt-oss-120b (~5B active, MXFP4,
# ~62 GB) FITS ON ONE NODE — that's the point: serve it solo, bench, then serve
# it TP=2 with this recipe and bench again. The delta IS the cost of the
# fabric. Community numbers: ~60 tok/s solo (eugr), "50-100" 2-node (ramsey).
MODEL=openai/gpt-oss-120b
SERVE_ARGS=(
  --tensor-parallel-size 2
  --gpu-memory-utilization 0.8
  --max-model-len 131072
  --max-num-seqs 4
  --async-scheduling
)
ENV_EXTRA=()
MODS=()
