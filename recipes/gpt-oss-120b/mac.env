# gpt-oss-120b on a Mac: llama.cpp with Metal, MXFP4, 128 GB of memory.
#
# 1 FIT     63.4 GB file; KV is 36 KiB a token, 4.7 GB for the whole 131072-token
#           window. A 128 GB Mac lets the GPU wire about 96 GB: it fits with the
#           full window. A 96 GB Mac (about 72 GB) fits at --ctx-size 32768; a
#           64 GB Mac (about 48 GB) does not.
WEIGHTS_GB=63.4
# 2 ENGINE  llama.cpp at rack's pinned build, Metal.
ENGINE=llamacpp
# 3 ACCESS  ggml-org's conversion, pinned.
. "$RECIPE_DIR/model.env"
ARTIFACT=ggml-org/gpt-oss-120b-GGUF/gpt-oss-120b-MXFP4.gguf
ARTIFACT_REVISION=238abdd290bb874b90a5da1b4549881b7d05c091
SERVE_ARGS=(
  # 4 SHAPE
  --n-gpu-layers 999
  --ctx-size 131072              # 128 GB Mac; 32768 on a 96 GB one
  # 5 DIALECT
  --jinja
  --reasoning-format deepseek
)
ENV_EXTRA=()
# 8 PROOF   not yet benched here: rack up gpt-oss-120b --mac && rack bench gpt-oss-120b-mac
