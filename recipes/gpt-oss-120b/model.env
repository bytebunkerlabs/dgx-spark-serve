# gpt-oss-120b — OpenAI's gpt-oss-120b: a mixture of experts (117B, 5.1B
# active), MXFP4 as shipped, always reasoning, with tool calls; a 131072-token
# window. What every platform shares. Apache-2.0, not gated
# (openai/gpt-oss-120b at b5c939d, checked 2026-10-12). The Sparks serve it
# from the flat phase2-gpt-oss-120b recipes; this folder is its Mac variant.
MODEL=openai/gpt-oss-120b
ROLES="chat tools reasoning"

# --- 5 DIALECT: what a client must do for correct answers (the app reads these)
# It always reasons; how much is the request's reasoning_effort, one of the
# card's three levels. There is no switch that turns thinking off.
DIALECT_EFFORT="low medium high"
# Harmony: earlier turns carry the final answer, not the analysis.
DIALECT_STRIP_REASONING=1
