# qwen3-8b on Windows (WSL2): llama.cpp with CUDA, Q4_K_M, an 8 GB GPU or more.
#
# 1 FIT     5.0 GB file; KV is 144 KiB per token (36 layers x 8 KV heads x 128
#           x K and V, fp16): 8192 tokens add 1.2 GB. Fits an 8 GB RTX 2070.
WEIGHTS_GB=5.0
# 2 ENGINE  llama.cpp at rack's pinned build, CUDA, inside WSL2.
ENGINE=llamacpp
# 3 ACCESS  Qwen's own GGUF repo, pinned.
. "$RECIPE_DIR/model.env"
ARTIFACT=Qwen/Qwen3-8B-GGUF/Qwen3-8B-Q4_K_M.gguf
ARTIFACT_REVISION=7c41481f57cb95916b40956ab2f0b139b296d974
SERVE_ARGS=(
  # 4 SHAPE
  --n-gpu-layers 999
  --ctx-size 8192                # 8 GB GPU; 16384 on 12 GB, 32768 on 16 GB
  # 5 DIALECT
  --jinja                        # Qwen's template: tool calls work
  --reasoning-format deepseek    # <think> spans become reasoning_content
)
ENV_EXTRA=()
# 8 PROOF   not yet benched here: rack up qwen3-8b --windows && rack bench qwen3-8b-windows
