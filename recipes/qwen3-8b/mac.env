# qwen3-8b on a Mac: llama.cpp with Metal, Q4_K_M, 16 GB of memory or more.
#
# 1 FIT     5.0 GB file; KV is 144 KiB per token: 16384 tokens add 2.4 GB.
#           A 16 GB Mac lets the GPU wire about 10.7 GB: it fits.
WEIGHTS_GB=5.0
# 2 ENGINE  llama.cpp at rack's pinned build, Metal.
ENGINE=llamacpp
# 3 ACCESS  Qwen's own GGUF repo, pinned.
. "$RECIPE_DIR/model.env"
ARTIFACT=Qwen/Qwen3-8B-GGUF/Qwen3-8B-Q4_K_M.gguf
ARTIFACT_REVISION=7c41481f57cb95916b40956ab2f0b139b296d974
SERVE_ARGS=(
  # 4 SHAPE
  --n-gpu-layers 999
  --ctx-size 16384               # 16 GB Mac; 40960 (the native window) from 32 GB
  # 5 DIALECT
  --jinja
  --reasoning-format deepseek
)
ENV_EXTRA=()
# 8 PROOF   not yet benched here: rack up qwen3-8b --mac && rack bench qwen3-8b-mac
