# qwen3-8b on NVIDIA Linux: vLLM, bf16, one GPU with 24 GB or more.
#
# 1 FIT     16.4 GB of bf16 weights. A 24 GB card holds them with room for
#           about 40k tokens of KV; a 16 GB card does not: use a GGUF variant.
WEIGHTS_GB=16.4
# 2 ENGINE  upstream vLLM, x86_64 or arm64. Ampere or newer (RTX 30xx and up):
#           Turing (RTX 20xx) needs fp16 and Triton attention in vLLM, and is
#           better served by llama.cpp (windows.env's flags work on Linux too).
ENGINE=vllm
IMAGE=vllm/vllm-openai:v0.26.0
# 3 ACCESS  model.env.
. "$RECIPE_DIR/model.env"
SERVE_ARGS=(
  # 4 SHAPE
  --gpu-memory-utilization 0.92  # discrete GPU memory: the engine may take nearly all of it
  --max-model-len 16384          # 24 GB; raise toward 40960 on a 48 GB card
  --enable-prefix-caching
  # 5 DIALECT
  --enable-auto-tool-choice
  --tool-call-parser hermes
  --reasoning-parser qwen3
)
ENV_EXTRA=()
MODS=()
# 8 PROOF   not yet benched here: rack up qwen3-8b --linux && rack bench qwen3-8b-linux
