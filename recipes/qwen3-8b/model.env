# qwen3-8b — Qwen3 8B: dense, with thinking and tool calls, on every platform.
# What every platform shares; dgx.env, linux.env, windows.env and mac.env
# source it. Apache-2.0, not gated.
MODEL=Qwen/Qwen3-8B
ROLES="chat tools reasoning"

# --- 5 DIALECT: what a client must do for correct answers (the app reads these)
# Thinking is on by default; turn it off per request for quick answers.
DIALECT_THINKING=chat_template_kwargs.enable_thinking
# Qwen: earlier turns' thinking stays out of the history (the model card's
# "no thinking content in history").
DIALECT_STRIP_REASONING=1
# The model card's thinking-mode sampling; greedy decoding makes it loop.
DIALECT_SAMPLING="temperature=0.6 top_p=0.95 top_k=20 min_p=0"
