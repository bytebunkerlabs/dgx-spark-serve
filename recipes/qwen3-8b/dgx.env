# qwen3-8b on a DGX Spark: vLLM, bf16, one node.
#
# 1 FIT     16.4 GB of bf16 weights in 5 shards (Qwen/Qwen3-8B b968826).
#           One Spark, with room to spare.
WEIGHTS_GB=16.4
# 2 ENGINE  the rack's image (rack build): Qwen3 has been in vLLM since 0.8.
ENGINE=vllm
# 3 ACCESS  model.env.
. "$RECIPE_DIR/model.env"
SERVE_ARGS=(
  # 4 SHAPE
  --gpu-memory-utilization 0.3   # of ~121 GiB unified: the weights plus ~100k tokens of KV;
                                 # the rest stays free for other work on this Spark
  --max-model-len 40960          # the model's native window (max_position_embeddings)
  --enable-prefix-caching
  # 5 DIALECT (Qwen's vLLM deployment guide)
  --enable-auto-tool-choice
  --tool-call-parser hermes      # Qwen3 emits Hermes-style <tool_call> blocks
  --reasoning-parser qwen3       # <think> spans become reasoning_content
)
ENV_EXTRA=()
MODS=()
# 8 PROOF   not yet benched here: rack up qwen3-8b && rack bench qwen3-8b-dgx
