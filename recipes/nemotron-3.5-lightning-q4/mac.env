# nemotron-3.5-lightning-q4 on a Mac: llama.cpp b11430 with Metal, ggml-org's Q4_0 (18.9 GB), the baseline for nemotron-3.5-lightning-tf:
# the same window and streams, no drafts, text only. The day-to-day recipe is nemotron-3.5-lightning.
WEIGHTS_GB=18.9
ENGINE=llamacpp
. "$RECIPE_DIR/model.env"
ARTIFACT=ggml-org/NVIDIA-Nemotron-3.5-Lightning-30B-A3B-GGUF/NVIDIA-Nemotron-3.5-Lightning-30B-A3B-Q4_0.gguf
ARTIFACT_REVISION=8a08a1c81dadcc75d35dbb96016cfd344b632e67
SERVE_ARGS=(
  # 4 SHAPE   the same as nemotron-3.5-lightning-tf's: a 65536-token window, 4 streams at once
  --n-gpu-layers 999
  --ctx-size 65536
  --parallel 4
  --kv-unified                   # one cache for the 4 slots: any one request may use all 65536
  # 5 DIALECT
  --jinja
  --reasoning-format deepseek
)
ENV_EXTRA=()
# 8 PROOF   bench/results.jsonl, labels nemotron-3.5-lightning-q4-*
