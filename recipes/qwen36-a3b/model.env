# qwen36-a3b — Qwen3.6 35B-A3B for the engine A/B on a Mac: llama.cpp (this
# folder, mac.env) against TensorFold (qwen36-a3b-tf, drafts on, and
# qwen36-a3b-tf-nodraft). A mixture of experts, 35B with ~3B active; thinking
# and tool calls; a 262144-token window. Apache-2.0, not gated
# (Qwen/Qwen3.6-35B-A3B). The day-to-day recipe stays qwen3.6-35b-a3b (Q8_0).
MODEL=Qwen/Qwen3.6-35B-A3B
ROLES="chat tools reasoning code"

# --- 5 DIALECT: what a client must do for correct answers (the app reads these)
# Thinking is on by default; a request turns it off.
DIALECT_THINKING=chat_template_kwargs.enable_thinking
DIALECT_STRIP_REASONING=1
DIALECT_SAMPLING="temperature=1.0 top_p=0.95 top_k=20 min_p=0 presence_penalty=1.5"
