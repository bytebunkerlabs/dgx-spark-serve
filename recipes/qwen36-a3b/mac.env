# qwen36-a3b on a Mac: llama.cpp with Metal, unsloth's UD-Q4_K_M. The A/B
# baseline against TensorFold (qwen36-a3b-tf): same context, same 4 slots.
#
# 1 FIT     rack fit unsloth/Qwen3.6-35B-A3B-GGUF --mac: UD-Q4_K_M is 22.1 GB
#           (34.7 B parameters: 5.1 bits a weight; the vision projector is a
#           separate file and not loaded). KV is 20 KiB a token (most layers are
#           linear attention): 1.3 GB at 65536 tokens. Fits from a 36 GB Mac.
WEIGHTS_GB=22.1
# 2 ENGINE  llama.cpp at rack's pinned build, Metal.
ENGINE=llamacpp
# 3 ACCESS  unsloth's conversion, pinned.
. "$RECIPE_DIR/model.env"
ARTIFACT=unsloth/Qwen3.6-35B-A3B-GGUF/Qwen3.6-35B-A3B-UD-Q4_K_M.gguf
ARTIFACT_REVISION=a483e9e6cbd595906af30beda3187c2663a1118c
SERVE_ARGS=(
  # 4 SHAPE   the same as TensorFold's: a 65536-token window, 4 streams at once
  --n-gpu-layers 999
  --ctx-size 65536
  --parallel 4
  --kv-unified                   # one cache for the 4 slots: any one request may use all 65536
  # 5 DIALECT
  --jinja                        # Qwen's template: tool calls work
  --reasoning-format deepseek    # <think> spans become reasoning_content
)
ENV_EXTRA=()
# 8 PROOF   bench/results.jsonl, labels qwen36-a3b-llamacpp-*
