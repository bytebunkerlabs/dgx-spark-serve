# gemma-4-26b-a4b-q4 on a Mac: llama.cpp b11430 with Metal, ggml-org's Q4_0 (14.6 GB), the baseline for gemma-4-26b-a4b-tf:
# the same window and streams, no drafts, text only. The day-to-day recipe is gemma-4-26b-a4b.
WEIGHTS_GB=14.6
ENGINE=llamacpp
. "$RECIPE_DIR/model.env"
ARTIFACT=ggml-org/gemma-4-26B-A4B-it-GGUF/gemma-4-26B-A4B-it-Q4_0.gguf
ARTIFACT_REVISION=bb4531cda34d1ea09d9814959ed4d5833cf2a4c8
SERVE_ARGS=(
  # 4 SHAPE   the same as gemma-4-26b-a4b-tf's: a 65536-token window, 4 streams at once
  --n-gpu-layers 999
  --ctx-size 65536
  --parallel 4
  --kv-unified                   # one cache for the 4 slots: any one request may use all 65536
  # 5 DIALECT
  --jinja
  --reasoning-format deepseek
)
ENV_EXTRA=()
# 8 PROOF   bench/results.jsonl, labels gemma-4-26b-a4b-q4-*
