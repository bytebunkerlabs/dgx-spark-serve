# gemma-4-31b on a Mac: llama.cpp with Metal, Q8_0, 64 GB of memory or more.
#
# 1 FIT     32.6 GB file plus a 0.8 GB vision projector; KV is 160 KiB a token
#           (dense, every layer keeps it), 10.5 GB at 65536 tokens. A 64 GB Mac
#           lets the GPU wire about 48 GB: it fits up to about 77k tokens. From
#           128 GB, the whole 262144-token window. On a 32 or 48 GB Mac,
#           gemma-4-31B-it-Q4_0.gguf (18.0 GB) in the same repo.
WEIGHTS_GB=33.4
# 2 ENGINE  llama.cpp at rack's pinned build, Metal.
ENGINE=llamacpp
# 3 ACCESS  ggml-org's conversion, pinned.
. "$RECIPE_DIR/model.env"
ARTIFACT=ggml-org/gemma-4-31B-it-GGUF/gemma-4-31B-it-Q8_0.gguf
ARTIFACT_MMPROJ=ggml-org/gemma-4-31B-it-GGUF/mmproj-gemma-4-31B-it-Q8_0.gguf
ARTIFACT_REVISION=4fa4fdf38bee237b5c9e8a5b4e72cf39404c9dcc
SERVE_ARGS=(
  # 4 SHAPE
  --n-gpu-layers 999
  --ctx-size 65536               # 64 GB Mac; 262144 (the model's window) on 128 GB
  # 5 DIALECT
  --jinja                        # Gemma's template: tool calls work
  --reasoning-format deepseek    # thinking becomes reasoning_content
)
ENV_EXTRA=()
# 8 PROOF   not yet benched here: rack up gemma-4-31b --mac && rack bench gemma-4-31b-mac
