# Phase 1 — smallest end-to-end path: one node, one small dense model.
# ~16 GB of weights; boots fast; exists purely to prove image + engine + API.
MODEL=Qwen/Qwen3-8B
SERVE_ARGS=(
  # NGC release notes, Spark known issue: start at 0.7 to avoid shared-memory
  # OOM on unified memory. This is a sizing knob, not a speed knob.
  --gpu-memory-utilization 0.7
  --max-model-len 32768
)
ENV_EXTRA=()
MODS=()
