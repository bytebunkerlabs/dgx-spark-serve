# gemma-4-12b on a DGX Spark: vLLM, bf16, one node.
#
# 1 FIT     24.0 GB: the bf16 weights in one file, and the tokenizer. KV is 64 KiB per token on the
#           8 global layers; the 40 sliding layers keep 1024 tokens each, so a
#           131072-token window is 8 GiB. One Spark, with most of it left free.
WEIGHTS_GB=24.0
# 2 ENGINE  the rack's image (rack build). The encoder-free 12B needs vLLM 0.23
#           or newer (vllm#44429).
ENGINE=vllm
# 3 ACCESS  model.env.
. "$RECIPE_DIR/model.env"
SERVE_ARGS=(
  # 4 SHAPE
  --gpu-memory-utilization 0.35  # of ~121 GiB unified: the weights plus about two full windows
  --max-model-len 131072         # vLLM's recipe pins 128k; the card says 256k
  --enable-prefix-caching
  --limit-mm-per-prompt '{"image":4,"audio":0}'   # no memory kept for audio, which needs vLLM's audio extras
  # 5 DIALECT (vLLM's Gemma 4 recipe)
  --enable-auto-tool-choice
  --tool-call-parser gemma4
  --reasoning-parser gemma4      # the thought channel becomes reasoning_content
  # vLLM's guide adds --chat-template examples/tool_chat_template_gemma4.jinja;
  # the checkpoint's own template carries the tool protocol, and that path is
  # not in every image.
)
ENV_EXTRA=()
MODS=()
# 8 PROOF   not yet benched here: rack up gemma-4-12b && rack bench gemma-4-12b-dgx
