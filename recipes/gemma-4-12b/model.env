# gemma-4-12b — Google's Gemma 4 12B: dense, with images, thinking and tool
# calls; a 262144-token window. What every platform shares; dgx.env,
# linux.env, windows.env and mac.env source it. Apache-2.0, not gated
# (google/gemma-4-12B-it at 707f0a3, checked 2026-10-11).
MODEL=google/gemma-4-12B-it
ROLES="chat tools reasoning vision"

# --- 5 DIALECT: what a client must do for correct answers (the app reads these)
# Thinking is off by default; a request turns it on (the model card's
# enable_thinking).
DIALECT_THINKING=chat_template_kwargs.enable_thinking
# The model card: earlier turns carry only the final answer, never the thoughts.
DIALECT_STRIP_REASONING=1
# The model card's one sampling configuration, for every use.
DIALECT_SAMPLING="temperature=1.0 top_p=0.95 top_k=64"
