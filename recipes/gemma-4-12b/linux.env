# gemma-4-12b on NVIDIA Linux: vLLM, Google's 4-bit QAT build, one GPU with 16 GB or more.
#
# 1 FIT     10.3 GB: google/gemma-4-12B-it-qat-w4a16-ct, Google's
#           quantization-aware build (4-bit weights, 16-bit activations).
#           A 16 GB card holds it with about 32k tokens of KV.
WEIGHTS_GB=10.3
# 2 ENGINE  upstream vLLM: the encoder-free 12B needs 0.23 or newer. Ampere or
#           newer (vLLM's recipe: the W4A16 build "runs on any GPU").
ENGINE=vllm
IMAGE=vllm/vllm-openai:v0.26.0
# 3 ACCESS  model.env, at Google's 4-bit checkpoint (1d2c2d7, checked 2026-10-11).
. "$RECIPE_DIR/model.env"
MODEL=google/gemma-4-12B-it-qat-w4a16-ct
SERVE_ARGS=(
  # 4 SHAPE
  --gpu-memory-utilization 0.92  # discrete GPU memory: the engine may take nearly all of it
  --max-model-len 32768          # 16 GB; raise toward 131072 on 24 GB and up
  --enable-prefix-caching
  --limit-mm-per-prompt '{"image":4,"audio":0}'
  # 5 DIALECT
  --enable-auto-tool-choice
  --tool-call-parser gemma4
  --reasoning-parser gemma4
)
ENV_EXTRA=()
MODS=()
# 8 PROOF   not yet benched here: rack up gemma-4-12b --linux && rack bench gemma-4-12b-linux
