# gemma-4-12b on Windows (WSL2): llama.cpp with CUDA, Google's QAT Q4_0, a 12 GB GPU or more.
#
# 1 FIT     7.0 GB file plus a 0.2 GB vision projector. KV is 64 KiB per token
#           on the 8 global layers (the 40 sliding layers keep 1024 tokens):
#           16384 tokens add 1 GiB. Fits a 12 GB card; an 8 GB card does not.
WEIGHTS_GB=7.2
# 2 ENGINE  llama.cpp at rack's pinned build, CUDA, inside WSL2.
ENGINE=llamacpp
# 3 ACCESS  Google's own QAT GGUF repo, pinned.
. "$RECIPE_DIR/model.env"
ARTIFACT=google/gemma-4-12B-it-qat-q4_0-gguf/gemma-4-12b-it-qat-q4_0.gguf
ARTIFACT_MMPROJ=google/gemma-4-12B-it-qat-q4_0-gguf/mmproj-gemma-4-12b-it-qat-q4_0.gguf
ARTIFACT_REVISION=29d097773436b69ff9feafd636ab4cf873786537
SERVE_ARGS=(
  # 4 SHAPE
  --n-gpu-layers 999
  --ctx-size 16384               # 12 GB GPU; 65536 on 16 GB
  # 5 DIALECT
  --jinja                        # Gemma's own template: tool calls work
  --reasoning-format deepseek    # the thought channel becomes reasoning_content
)
ENV_EXTRA=()
# 8 PROOF   not yet benched here: rack up gemma-4-12b --windows && rack bench gemma-4-12b-windows
