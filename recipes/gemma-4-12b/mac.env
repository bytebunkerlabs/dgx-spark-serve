# gemma-4-12b on a Mac: llama.cpp with Metal, Google's QAT Q4_0, 16 GB of memory or more.
#
# 1 FIT     7.0 GB file plus a 0.2 GB vision projector; 32768 tokens of KV add
#           2 GiB. A 16 GB Mac lets the GPU wire about 10.7 GB: it fits.
WEIGHTS_GB=7.2
# 2 ENGINE  llama.cpp at rack's pinned build, Metal.
ENGINE=llamacpp
# 3 ACCESS  Google's own QAT GGUF repo, pinned.
. "$RECIPE_DIR/model.env"
ARTIFACT=google/gemma-4-12B-it-qat-q4_0-gguf/gemma-4-12b-it-qat-q4_0.gguf
ARTIFACT_MMPROJ=google/gemma-4-12B-it-qat-q4_0-gguf/mmproj-gemma-4-12b-it-qat-q4_0.gguf
ARTIFACT_REVISION=29d097773436b69ff9feafd636ab4cf873786537
SERVE_ARGS=(
  # 4 SHAPE
  --n-gpu-layers 999
  --ctx-size 32768               # 16 GB Mac; 131072 from 32 GB
  # 5 DIALECT
  --jinja
  --reasoning-format deepseek
)
ENV_EXTRA=()
# 8 PROOF   not yet benched here: rack up gemma-4-12b --mac && rack bench gemma-4-12b-mac
