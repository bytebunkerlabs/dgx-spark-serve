# dsv4-ab — DeepSeek-V4-Flash-0731, abliterated FP8 build (apetersson).
#
# Third-party derivative of deepseek-ai/DeepSeek-V4-Flash-0731 with the
# refusal direction ablated. Byte-for-byte the same serving profile as the
# original (166.9 GB download, 304.2B params, fp8, DeepseekV4ForCausalLM,
# native 1M context — checked against the HF API 2026-08-05), so every
# hard-won dsv4 setting carries over verbatim: parsers, fp8 MLA KV, the
# PIECEWISE cudagraph rule, the full 1M window. See dsv4.env for the whole
# story on thinking mode, effort coercion, and reasoning echo-back — it all
# applies here unchanged.
#
# Community weights, not the vendor's: verify behavior yourself before
# trusting it with anything that matters. Pull with:
#   rack pull apetersson/DeepSeek-V4-Flash-0731-Abliterated-FP8
# (downloads + replicates to spark-2 + verifies shards — TP=2 needs both).
#
# Both video engines must be down first (this takes the whole pair):
#   spark-1: rack down     spark-2: Ctrl-C its rack terminal
#
# Console caps: when adding to LiteLLM, give it a public name containing
# "deepseek-v4" (e.g. deepseek-v4-abliterated) — the console's capability
# table matches by substring, and this model needs the same treatment
# (thinking via chat_template_kwargs, reasoning_content echo-back, 1M ctx).
MODEL=apetersson/DeepSeek-V4-Flash-0731-Abliterated-FP8
SERVE_ARGS=(
  --host 0.0.0.0                 # LiteLLM reaches this from its bridge network
  --port 8888
  --served-model-name dsv4-ab
  --trust-remote-code
  --enable-auto-tool-choice
  --tool-call-parser deepseek_v4
  --reasoning-parser deepseek_v4  # needed, not sufficient — see dsv4.env
  --tensor-parallel-size 2
  --gpu-memory-utilization 0.8   # sizing knob, not a speed knob; 0.8 is near the edge
  --max-model-len 1048576        # native YaRN 1M, same geometry as dsv4 (measured there)
  --max-num-seqs 4
  --kv-cache-dtype fp8           # required: fp8_ds_mla layout rejects 'auto'
  --enable-prefix-caching
  --enable-chunked-prefill
  --async-scheduling
  # PIECEWISE: FULL graph capture does not converge on cross-node GB10.
  --compilation-config '{"cudagraph_mode":"PIECEWISE","custom_ops":["all"]}'
)
ENV_EXTRA=()
MODS=()
