# gemma-4-26b-a4b — Google's Gemma 4 26B-A4B: a mixture of experts (26B, 4B
# active), with images, thinking and tool calls; a 262144-token window. What
# every platform shares. Apache-2.0, not gated (google/gemma-4-26B-A4B-it at
# 4d7ae49, checked 2026-10-12).
MODEL=google/gemma-4-26B-A4B-it
ROLES="chat tools reasoning vision"

# --- 5 DIALECT: what a client must do for correct answers (the app reads these)
# Thinking is off by default; a request turns it on (enable_thinking).
DIALECT_THINKING=chat_template_kwargs.enable_thinking
# Earlier turns carry only the final answer, never the thoughts.
DIALECT_STRIP_REASONING=1
# The model card's one sampling configuration, for every use.
DIALECT_SAMPLING="temperature=1.0 top_p=0.95 top_k=64"
