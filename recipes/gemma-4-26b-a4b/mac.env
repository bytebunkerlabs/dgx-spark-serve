# gemma-4-26b-a4b on a Mac: llama.cpp with Metal, Q8_0, 48 GB of memory or more.
#
# 1 FIT     26.9 GB file plus a 0.8 GB vision projector; KV is 40 KiB a token,
#           2.6 GB at 65536 tokens and 5.2 GB at 131072. A 48 GB Mac lets the GPU
#           wire about 36 GB: it fits at 65536. From 64 GB (about 48 GB), 131072
#           or more. On a 32 GB Mac, gemma-4-26B-A4B-it-Q4_0.gguf (14.6 GB).
WEIGHTS_GB=27.7
# 2 ENGINE  llama.cpp at rack's pinned build, Metal.
ENGINE=llamacpp
# 3 ACCESS  ggml-org's conversion, pinned.
. "$RECIPE_DIR/model.env"
ARTIFACT=ggml-org/gemma-4-26B-A4B-it-GGUF/gemma-4-26B-A4B-it-Q8_0.gguf
ARTIFACT_MMPROJ=ggml-org/gemma-4-26B-A4B-it-GGUF/mmproj-gemma-4-26B-A4B-it-Q8_0.gguf
ARTIFACT_REVISION=bb4531cda34d1ea09d9814959ed4d5833cf2a4c8
SERVE_ARGS=(
  # 4 SHAPE
  --n-gpu-layers 999
  --ctx-size 65536               # 48 GB Mac; 131072 from 64 GB
  # 5 DIALECT
  --jinja                        # Gemma's template: tool calls work
  --reasoning-format deepseek    # thinking becomes reasoning_content
)
ENV_EXTRA=()
# 8 PROOF   not yet benched here: rack up gemma-4-26b-a4b --mac && rack bench gemma-4-26b-a4b-mac
