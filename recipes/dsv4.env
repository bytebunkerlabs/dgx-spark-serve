# dsv4 — scaffolded 2026-07-31 by: rack new
# Check the fit first:  rack fit deepseek-ai/DeepSeek-V4-Flash-0731
#
# THINKING MODE is a per-request setting, not a serve flag, and vLLM's default
# is the opposite of DeepSeek's hosted API. api-docs.deepseek.com says thinking
# is on by default at effort "high"; vllm/tokenizers/deepseek_v4.py says:
#     thinking = kwargs.get("thinking", False)        # off unless asked
# so --reasoning-parser alone yields no reasoning_content — the parser is
# waiting for a <think> span the model was never told to emit. Ask for it:
#     "chat_template_kwargs": {"thinking": true, "reasoning_effort": "max"}
#
# The same file asserts reasoning_effort in ['max', 'high', None] — "low" is a
# hard error, not a no-op — and only 'max' changes the prompt (it prepends a
# thoroughness preamble at turn 0). So there are effectively two settings here,
# on and off, whatever the docs' four levels imply.
#
# One more trap, from DeepSeek's own docs: once tool calls are in play,
# reasoning_content MUST be echoed back in subsequent requests or the model
# 400s. Clients that strip prior thinking (most do, to save context) break on
# the second hop of a tool conversation.
MODEL=deepseek-ai/DeepSeek-V4-Flash-0731
SERVE_ARGS=(
  --host 0.0.0.0                 # LiteLLM reaches this from its bridge network
  --port 8888
  --served-model-name dsv4
  --trust-remote-code
  --enable-auto-tool-choice
  --tool-call-parser deepseek_v4
  --reasoning-parser deepseek_v4  # needed, but not sufficient — see below
  --tensor-parallel-size 2       # drop to 1 if it fits on a single node
  --gpu-memory-utilization 0.8   # sizing knob, not a speed knob; 0.8 is near the edge
  --max-model-len 131072         # trade against max-num-seqs; never raise both
  --max-num-seqs 4
  --kv-cache-dtype fp8           # required: fp8_ds_mla layout rejects 'auto'
  --enable-prefix-caching
  --enable-chunked-prefill
  --async-scheduling
  # PIECEWISE: FULL graph capture does not converge on cross-node GB10.
  # Last resort if startup still fails: --enforce-eager
  --compilation-config '{"cudagraph_mode":"PIECEWISE","custom_ops":["all"]}'
  # --speculative-config  # MTP head shape mismatch: KeyError mtp_block.main_norm — revisit when vLLM catches up '{"method":"deepseek_mtp","num_speculative_tokens":1}'
)
ENV_EXTRA=()   # e.g. LAMPORT_RS_SCONV=0 for models with NVLink-assuming collectives
MODS=()        # e.g. mods/inkling-sm12-paged-kv
