# glm-4.7-flash — Z.ai's GLM-4.7-Flash: a mixture of experts, with thinking
# and tool calls; a 202752-token window. What every platform shares. MIT, not
# gated (zai-org/GLM-4.7-Flash at 7dd2089, checked 2026-10-12).
MODEL=zai-org/GLM-4.7-Flash
ROLES="chat tools reasoning code"

# --- 5 DIALECT: what a client must do for correct answers (the app reads these)
# Thinking is on by default; a request turns it off.
DIALECT_THINKING=chat_template_kwargs.enable_thinking
# clear_thinking is the template's default: earlier turns go back without their thinking.
DIALECT_STRIP_REASONING=1
# The card's general sampling.
DIALECT_SAMPLING="temperature=1.0"
