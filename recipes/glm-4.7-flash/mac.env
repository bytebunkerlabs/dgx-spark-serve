# glm-4.7-flash on a Mac: llama.cpp with Metal, Q8_0, 64 GB of memory or more.
#
# 1 FIT     31.8 GB file; KV is 52 KiB a token, 6.8 GB at 131072 tokens. A 64 GB
#           Mac lets the GPU wire about 48 GB: it fits, up to the whole
#           202752-token window. On a 32 or 48 GB Mac, GLM-4.7-Flash-Q4_K.gguf
#           (18.2 GB) in the same repo.
WEIGHTS_GB=31.8
# 2 ENGINE  llama.cpp at rack's pinned build, Metal.
ENGINE=llamacpp
# 3 ACCESS  ggml-org's conversion, pinned.
. "$RECIPE_DIR/model.env"
ARTIFACT=ggml-org/GLM-4.7-Flash-GGUF/GLM-4.7-Flash-Q8_0.gguf
ARTIFACT_REVISION=7559e96b7e324ab405897dc2b91492b0f376ad4a
SERVE_ARGS=(
  # 4 SHAPE
  --n-gpu-layers 999
  --ctx-size 131072              # 64 GB Mac; 202752 (the model's window) fits too
  # 5 DIALECT
  --jinja                        # GLM's template: tool calls work
  --reasoning-format deepseek    # <think> spans become reasoning_content
)
ENV_EXTRA=()
# 8 PROOF   not yet benched here: rack up glm-4.7-flash --mac && rack bench glm-4.7-flash-mac
