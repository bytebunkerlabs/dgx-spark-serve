# qwen3.6-35b-a3b on a Mac: llama.cpp with Metal, Q8_0, 64 GB of memory or more.
#
# 1 FIT     36.9 GB file plus a 0.6 GB vision projector; KV is 20 KiB a token
#           (most layers are linear attention), 2.6 GB at 131072 tokens. A 64 GB
#           Mac lets the GPU wire about 48 GB: it fits, even with the whole
#           262144-token window. On a 32 or 48 GB Mac, Qwen3.6-35B-A3B-Q4_K_M.gguf
#           (20.4 GB) in the same repo.
WEIGHTS_GB=37.5
# 2 ENGINE  llama.cpp at rack's pinned build, Metal.
ENGINE=llamacpp
# 3 ACCESS  ggml-org's conversion, pinned.
. "$RECIPE_DIR/model.env"
ARTIFACT=ggml-org/Qwen3.6-35B-A3B-GGUF/Qwen3.6-35B-A3B-Q8_0.gguf
ARTIFACT_MMPROJ=ggml-org/Qwen3.6-35B-A3B-GGUF/mmproj-Qwen3.6-35B-A3B-Q8_0.gguf
ARTIFACT_REVISION=baec3ebee244827cda0f4557eafa8b28f7545fa6
SERVE_ARGS=(
  # 4 SHAPE
  --n-gpu-layers 999
  --ctx-size 131072              # 262144 (the model's window) fits from 64 GB too
  # 5 DIALECT
  --jinja                        # Qwen's template: tool calls work
  --reasoning-format deepseek    # <think> spans become reasoning_content
)
ENV_EXTRA=()
# 8 PROOF   not yet benched here: rack up qwen3.6-35b-a3b --mac && rack bench qwen3.6-35b-a3b-mac
