# qwen3.6-35b-a3b — Qwen3.6 35B-A3B: a mixture of experts (35B, 3B active),
# with images, thinking and tool calls; a 262144-token window. What every
# platform shares. Apache-2.0, not gated (Qwen/Qwen3.6-35B-A3B at 995ad96,
# checked 2026-10-12).
MODEL=Qwen/Qwen3.6-35B-A3B
ROLES="chat tools reasoning vision code"

# --- 5 DIALECT: what a client must do for correct answers (the app reads these)
# Thinking is on by default; a request turns it off.
DIALECT_THINKING=chat_template_kwargs.enable_thinking
# preserve_thinking is off by default: earlier turns go back without their thinking.
DIALECT_STRIP_REASONING=1
# The card's thinking-mode sampling for general tasks (without thinking:
# temperature=0.7 top_p=0.8 top_k=20 presence_penalty=1.5).
DIALECT_SAMPLING="temperature=1.0 top_p=0.95 top_k=20 min_p=0 presence_penalty=1.5"
