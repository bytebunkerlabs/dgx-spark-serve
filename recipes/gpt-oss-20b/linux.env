# gpt-oss-20b on NVIDIA Linux: vLLM, MXFP4, one GPU with 24 GB (16 GB at a short window).
#
# 1 FIT     13.8 GB of weights. A 24 GB card holds them with the full
#           131072-token window (3 GiB of KV); a 16 GB card has room for about
#           16k tokens beside them.
WEIGHTS_GB=13.8
# 2 ENGINE  upstream vLLM. Hopper and Blackwell run MXFP4 natively; Ampere and
#           Ada run it through Marlin with Triton attention (vLLM's GPT-OSS
#           guide). Older cards: windows.env's llama.cpp flags work on Linux too.
ENGINE=vllm
IMAGE=vllm/vllm-openai:v0.26.0
# 3 ACCESS  model.env.
. "$RECIPE_DIR/model.env"
SERVE_ARGS=(
  # 4 SHAPE
  --gpu-memory-utilization 0.92  # discrete GPU memory: the engine may take nearly all of it
  --max-model-len 131072         # 24 GB; 16384 on a 16 GB card
  --enable-prefix-caching
  --async-scheduling
  # 5 DIALECT
  --enable-auto-tool-choice
  --tool-call-parser openai
)
ENV_EXTRA=(
  # TIKTOKEN_ENCODINGS_BASE=/root/.cache/huggingface/tiktoken   # offline vocabulary: dgx.env says how
)
MODS=()
# 8 PROOF   not yet benched here: rack up gpt-oss-20b --linux && rack bench gpt-oss-20b-linux
