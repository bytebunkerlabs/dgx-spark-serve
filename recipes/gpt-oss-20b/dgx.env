# gpt-oss-20b on a DGX Spark: vLLM, MXFP4 as shipped, one node.
#
# 1 FIT     13.8 GB in 3 shards (MXFP4 experts, bf16 attention); rack pull
#           skips the repo's original/ and metal/ copies. KV is 24 KiB per
#           token on the 12 full-attention layers (the other 12 keep a
#           128-token window): a 131072-token window is 3 GiB.
WEIGHTS_GB=13.8
# 2 ENGINE  the rack's image (rack build); gpt-oss has been in vLLM since 0.10.1.
ENGINE=vllm
# 3 ACCESS  model.env.
. "$RECIPE_DIR/model.env"
SERVE_ARGS=(
  # 4 SHAPE
  --gpu-memory-utilization 0.25  # of ~121 GiB unified: the weights plus a few full windows
  --max-model-len 131072         # the model's window (YaRN from 4k, in config.json)
  --enable-prefix-caching
  --async-scheduling             # as the gpt-oss-120b recipes
  # 5 DIALECT (vLLM's GPT-OSS guide)
  --enable-auto-tool-choice
  --tool-call-parser openai      # harmony tool calls; the reasoning needs no parser
)
# 6 ENV     vLLM's harmony tokenizer loads the o200k_base vocabulary, and vLLM's
#           guide says it downloads it from openaipublic.blob.core.windows.net
#           when no copy is set. To keep the engine offline, put
#           o200k_base.tiktoken and cl100k_base.tiktoken in $HF_CACHE/tiktoken
#           and uncomment (the cache is mounted at /root/.cache/huggingface):
ENV_EXTRA=(
  # TIKTOKEN_ENCODINGS_BASE=/root/.cache/huggingface/tiktoken
)
MODS=()
# 8 PROOF   not yet benched here: rack up gpt-oss-20b && rack bench gpt-oss-20b-dgx
