# gpt-oss-20b on Windows (WSL2): llama.cpp with CUDA, MXFP4, a 16 GB GPU or more.
#
# 1 FIT     12.1 GB file; KV is 24 KiB per token on the 12 full-attention
#           layers: 32768 tokens add 0.8 GiB. Fits a 16 GB card; an 8 GB one
#           does not. The tokenizer is inside the file: nothing to download at start.
WEIGHTS_GB=12.1
# 2 ENGINE  llama.cpp at rack's pinned build, CUDA, inside WSL2.
ENGINE=llamacpp
# 3 ACCESS  ggml-org's conversion (the llama.cpp project's own), pinned.
. "$RECIPE_DIR/model.env"
ARTIFACT=ggml-org/gpt-oss-20b-GGUF/gpt-oss-20b-MXFP4.gguf
ARTIFACT_REVISION=ef9b12f2ff56c69cf32153a02784e7a3c88bf524
SERVE_ARGS=(
  # 4 SHAPE
  --n-gpu-layers 999
  --ctx-size 32768               # 16 GB GPU; 131072 (the model's window) on 24 GB
  # 5 DIALECT
  --jinja                        # the harmony template: tool calls work
  --reasoning-format deepseek    # the analysis channel becomes reasoning_content
)
ENV_EXTRA=()
# 8 PROOF   not yet benched here: rack up gpt-oss-20b --windows && rack bench gpt-oss-20b-windows
