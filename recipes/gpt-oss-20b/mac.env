# gpt-oss-20b on a Mac: llama.cpp with Metal, MXFP4, 24 GB of memory or more.
#
# 1 FIT     12.1 GB file; 32768 tokens of KV add 0.8 GiB. A 24 GB Mac lets the
#           GPU wire about 16 GB: it fits. A 16 GB Mac (about 10.7 GB) does not.
WEIGHTS_GB=12.1
# 2 ENGINE  llama.cpp at rack's pinned build, Metal.
ENGINE=llamacpp
# 3 ACCESS  ggml-org's conversion, pinned.
. "$RECIPE_DIR/model.env"
ARTIFACT=ggml-org/gpt-oss-20b-GGUF/gpt-oss-20b-MXFP4.gguf
ARTIFACT_REVISION=ef9b12f2ff56c69cf32153a02784e7a3c88bf524
SERVE_ARGS=(
  # 4 SHAPE
  --n-gpu-layers 999
  --ctx-size 32768               # 24 GB Mac; 131072 (the model's window) from 32 GB
  # 5 DIALECT
  --jinja
  --reasoning-format deepseek
)
ENV_EXTRA=()
# 8 PROOF   not yet benched here: rack up gpt-oss-20b --mac && rack bench gpt-oss-20b-mac
