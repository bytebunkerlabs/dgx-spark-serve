# qwen36-a3b-tf-nodraft on a Mac: TensorFold 0.6.6, drafts off, one token a
# round: TensorFold's own serial reference. Everything else is qwen36-a3b-tf's;
# the one change is --no-drafts.
WEIGHTS_GB=20.9
ENGINE=tensorfold
. "$RECIPE_DIR/model.env"
ARTIFACT=TensorFold/Qwen3.6-35B-A3B-MLX-4bit-MTP
ARTIFACT_REVISION=f84b054c5677b6e59bdb969ae61915b0983d68bb
SERVE_ARGS=(
  --context 65536
  --parallel 4
  --no-drafts                    # the one change from qwen36-a3b-tf
)
ENV_EXTRA=()
# 8 PROOF   bench/results.jsonl, labels qwen36-a3b-tf-nodraft-*
