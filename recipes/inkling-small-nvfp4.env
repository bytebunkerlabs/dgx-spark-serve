# Phase 3 — the capstone. Inkling-Small-NVFP4: 276B-class total (~12B active),
# 170.7 GB on disk, ~85 GB of weights per node at TP=2. Requires:
#   image:  --profile upstream (vLLM >= 0.26.0 — NGC's 0.24 predates Inkling)
#   mod:    scripts/fetch-inkling-mod.sh   (FA4 sm_12x paged-KV patch; without
#           it every rank dies in warmup: "Paged KV not supported on SM 12.0")
#   memory: stop everything else + drop caches first (docs/03)
# Honest expectations (docs/03): no published Spark number exists for this
# model. ~12B-active NVFP4 comparables: ~20-25 tok/s without effective
# speculation; MTP is capped at k=1 until vllm#48768 merges.
MODEL=thinkingmachines/Inkling-Small-NVFP4
SERVE_ARGS=(
  --host 0.0.0.0                 # LiteLLM reaches it from its bridge network
  --port 8888                    # reuses the existing ufw allow 172.19.0.0/16->8888
  --served-model-name inkling-small
  --trust-remote-code            # Inkling ships custom tokenizer/config code
  --tokenizer-mode inkling
  --tensor-parallel-size 2
  --enable-auto-tool-choice
  --tool-call-parser inkling     # parser bugs until vllm#50403 (nightly-only fix)
  --reasoning-parser inkling
  --gpu-memory-utilization 0.8   # near the edge; big-Inkling forum: "0.78 wedges the node"
  --max-model-len 262144         # trade against max-num-seqs, never raise both
  --max-num-seqs 2
  --quantization nvfp4           # GB10-native; compressed-tensors NVFP4 support = vllm#49258
  --enable-prefix-caching
  --enable-chunked-prefill
  --async-scheduling
  # Fastest mode first; if startup graph capture OOMs on unified memory, the
  # documented fallback ladder is: PIECEWISE, then --enforce-eager (diagnostic).
  --compilation-config '{"cudagraph_mode":"FULL_AND_PIECEWISE","custom_ops":["all"]}'
  --speculative-config '{"method":"mtp","num_speculative_tokens":1}'
  # --load-format instanttensor  # needs --profile upstream image (INSTALL_EXTRAS);
  #                              # fastsafetensors is documented-unsafe at this
  #                              # size (>0.85 of RAM). Default loader is slow
  #                              # but safe — start there, then experiment.
)
ENV_EXTRA=(
  LAMPORT_RS_SCONV=0             # MANDATORY on RoCE: the Lamport fused reduce-
                                 # scatter assumes NVLink-class fabric; hard
                                 # error on a RoCE cluster without this
  VLLM_USE_AOT_COMPILE=1         # ahead-of-time compile, artifacts cached on disk
  VLLM_USE_BREAKABLE_CUDAGRAPH=0 # keep the experimental capture path off on GB10
)
MODS=(mods/inkling-sm12-paged-kv)
