# nemotron-3.5-lightning — NVIDIA Nemotron 3.5 Lightning 30B-A3B: a hybrid
# Mamba-Transformer mixture of experts (30B, 3B active), with thinking and tool
# calls; a 262144-token window. What every platform shares. NVIDIA's OpenMDW
# 1.1 license, not gated (nvidia/NVIDIA-Nemotron-3.5-Lightning-30B-A3B-BF16 at
# a9904d2, checked 2026-10-12).
MODEL=nvidia/NVIDIA-Nemotron-3.5-Lightning-30B-A3B-BF16
ROLES="chat tools reasoning code"

# --- 5 DIALECT: what a client must do for correct answers (the app reads these)
# Thinking is on by default; a request turns it off.
DIALECT_THINKING=chat_template_kwargs.enable_thinking
# The card's sampling.
DIALECT_SAMPLING="temperature=1.0 top_p=0.95"
