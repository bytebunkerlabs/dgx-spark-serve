# qwen3.8-27b — Qwen3.8 27B: dense, hybrid attention (48 of its 64 layers are
# linear), with images, thinking and tool calls; a 262144-token window. What
# every platform shares; dgx.env, linux.env, windows.env and mac.env source
# it. Apache-2.0, not gated (Qwen/Qwen3.8-27B at 1d4bf0f, checked 2026-10-11).
MODEL=Qwen/Qwen3.8-27B
ROLES="chat tools reasoning vision code"

# --- 5 DIALECT: what a client must do for correct answers (the app reads these)
# Thinking is on by default; a request turns it off.
DIALECT_THINKING=chat_template_kwargs.enable_thinking
# reasoning_effort: xhigh (the default), medium or low.
DIALECT_EFFORT="low medium xhigh"
# preserve_thinking is on: earlier turns' thinking goes back to the model.
DIALECT_ECHO_REASONING=1
# The card's thinking-mode sampling (without thinking: temperature=0.7
# top_p=0.8 top_k=20 presence_penalty=1.5).
DIALECT_SAMPLING="temperature=1.0 top_p=0.95 top_k=20 min_p=0 presence_penalty=0"
