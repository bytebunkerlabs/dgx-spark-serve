# qwen3.8-27b on a DGX Spark: vLLM, NVIDIA's NVFP4 build, one node.
#
# 1 FIT     21.9 GB: nvidia/Qwen3.8-27B-NVFP4 (NVFP4 and FP8, vision in bf16;
#           482ca0f, checked 2026-10-11). Only the 16 full-attention layers keep
#           KV: 32 KiB per token in fp8, so a 262144-token window is 8 GiB.
#           bf16 (55.6 GB) fits too, and reads 2.5 times the bytes per token.
WEIGHTS_GB=21.9
# 2 ENGINE  the rack's image (rack build): Qwen3.5's architecture, which this
#           model uses, has been in vLLM since 0.17. vLLM's own recipe for it
#           is verified on a DGX Spark with the flags below.
ENGINE=vllm
# 3 ACCESS  model.env, at NVIDIA's 4-bit checkpoint for Blackwell.
. "$RECIPE_DIR/model.env"
MODEL=nvidia/Qwen3.8-27B-NVFP4
SERVE_ARGS=(
  # 4 SHAPE (vLLM's recipe for GB10)
  --gpu-memory-utilization 0.7   # of ~121 GiB: about eight full windows; fewer --max-num-seqs needs less
  --max-model-len 262144         # the model's native window
  --max-num-seqs 8
  --max-num-batched-tokens 8192
  --kv-cache-dtype fp8
  --enable-chunked-prefill
  --enable-prefix-caching
  --async-scheduling
  # 5 DIALECT (vLLM's recipe)
  --enable-auto-tool-choice
  --tool-call-parser qwen3_coder
  --reasoning-parser qwen3       # <think> spans become reasoning_content
  # 7 PATCH   vLLM's recipe drafts 5 tokens with the built-in MTP head on GB10,
  #           but that needs the gated-delta-net fix (vllm#51812), in no release yet:
  # --speculative-config '{"method":"mtp","num_speculative_tokens":5}'
)
ENV_EXTRA=()
MODS=()
# 8 PROOF   not yet benched here: rack up qwen3.8-27b && rack bench qwen3.8-27b-dgx
