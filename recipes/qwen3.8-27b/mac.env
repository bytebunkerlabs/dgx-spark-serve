# qwen3.8-27b on a Mac: llama.cpp with Metal, Q4_K_M, 36 GB of memory or more.
#
# 1 FIT     19.0 GB file plus a 0.6 GB vision projector; 32768 tokens of KV add
#           2 GiB. A 36 GB Mac lets the GPU wire about 24 GB: it fits. A 32 GB
#           Mac (about 21 GB) does not, with room to think.
#           From 48 GB, Qwen3.8-27B-Q8_0.gguf (28.6 GB) in the same repo.
WEIGHTS_GB=19.6
# 2 ENGINE  llama.cpp at rack's pinned build, Metal.
ENGINE=llamacpp
# 3 ACCESS  ggml-org's conversion, pinned.
. "$RECIPE_DIR/model.env"
ARTIFACT=ggml-org/Qwen3.8-27B-GGUF/Qwen3.8-27B-Q4_K_M.gguf
ARTIFACT_MMPROJ=ggml-org/Qwen3.8-27B-GGUF/mmproj-Qwen3.8-27B-Q8_0.gguf
ARTIFACT_REVISION=71bc7b627595dc8a91039addd9c791ae548d6747
SERVE_ARGS=(
  # 4 SHAPE
  --n-gpu-layers 999
  --ctx-size 32768               # 36 GB Mac; 131072 from 48 GB
  # 5 DIALECT
  --jinja                        # Qwen's template: tool calls work
  --reasoning-format deepseek    # <think> spans become reasoning_content
)
ENV_EXTRA=()
# 8 PROOF   not yet benched here: rack up qwen3.8-27b --mac && rack bench qwen3.8-27b-mac
