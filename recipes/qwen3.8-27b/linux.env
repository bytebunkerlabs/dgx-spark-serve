# qwen3.8-27b on NVIDIA Linux: llama.cpp with CUDA, Q4_K_M, one GPU with 24 GB or more.
#
# 1 FIT     19.0 GB file plus a 0.6 GB vision projector. Only the 16
#           full-attention layers keep KV: 64 KiB per token, so 32768 tokens
#           add 2 GiB. A 24 GB card holds it at 32k.
WEIGHTS_GB=19.6
# 2 ENGINE  llama.cpp at rack's pinned build, CUDA: 4-bit on one 24 GB card.
#           vLLM's builds want more: FP8 (Qwen/Qwen3.8-27B-FP8, 30.9 GB) a
#           40 GB card or more, by vLLM's own recipe.
ENGINE=llamacpp
# 3 ACCESS  ggml-org's conversion (the llama.cpp project's own), pinned.
. "$RECIPE_DIR/model.env"
ARTIFACT=ggml-org/Qwen3.8-27B-GGUF/Qwen3.8-27B-Q4_K_M.gguf
ARTIFACT_MMPROJ=ggml-org/Qwen3.8-27B-GGUF/mmproj-Qwen3.8-27B-Q8_0.gguf
ARTIFACT_REVISION=71bc7b627595dc8a91039addd9c791ae548d6747
SERVE_ARGS=(
  # 4 SHAPE
  --n-gpu-layers 999
  --ctx-size 32768               # 24 GB; 131072 on 32 GB and up
  # 5 DIALECT
  --jinja                        # Qwen's template: tool calls work
  --reasoning-format deepseek    # <think> spans become reasoning_content
)
ENV_EXTRA=()
# 8 PROOF   not yet benched here: rack up qwen3.8-27b --linux && rack bench qwen3.8-27b-linux
