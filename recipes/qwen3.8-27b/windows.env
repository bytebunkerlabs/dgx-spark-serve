# qwen3.8-27b on Windows (WSL2): llama.cpp with CUDA, Q4_K_M, a 24 GB GPU or more.
#
# 1 FIT     19.0 GB file plus a 0.6 GB vision projector; KV is 64 KiB per token
#           on the 16 full-attention layers: 16384 tokens add 1 GiB. Fits a
#           24 GB card (RTX 3090, 4090) beside what Windows keeps for the desktop.
WEIGHTS_GB=19.6
# 2 ENGINE  llama.cpp at rack's pinned build, CUDA, inside WSL2.
ENGINE=llamacpp
# 3 ACCESS  ggml-org's conversion, pinned.
. "$RECIPE_DIR/model.env"
ARTIFACT=ggml-org/Qwen3.8-27B-GGUF/Qwen3.8-27B-Q4_K_M.gguf
ARTIFACT_MMPROJ=ggml-org/Qwen3.8-27B-GGUF/mmproj-Qwen3.8-27B-Q8_0.gguf
ARTIFACT_REVISION=71bc7b627595dc8a91039addd9c791ae548d6747
SERVE_ARGS=(
  # 4 SHAPE
  --n-gpu-layers 999
  --ctx-size 16384               # 24 GB GPU; 65536 on 32 GB
  # 5 DIALECT
  --jinja
  --reasoning-format deepseek
)
ENV_EXTRA=()
# 8 PROOF   not yet benched here: rack up qwen3.8-27b --windows && rack bench qwen3.8-27b-windows
