# dgx-spark-serve — copy to .env and adjust. Every script reads this; nothing
# else stores state. Values below are the cluster's real, measured defaults.

# --- nodes -------------------------------------------------------------------
HEAD_IP=192.168.100.1        # spark-1 fabric IP — the box you type on
WORKER_IP=192.168.100.2      # spark-2 fabric IP
WORKER_SSH=spark-2           # how the head reaches the worker (/etc/hosts → fabric IP)

# --- fabric ------------------------------------------------------------------
# One QSFP port, two PCIe Gen5 x4 rails (Socket Direct). Configure both or you
# serve on half the fabric. preflight.sh verifies all of this.
FABRIC_IF=enp1s0f0np0        # rail 1 netdev — carries TCP control plane
FABRIC_IF2=enP2p1s0f0np0     # rail 2 netdev — same physical port, second PCIe path
RDMA_DEV=rocep1s0f0          # rail 1 RDMA device (ibdev2netdev shows the mapping)
IB_HCAS=rocep1s0f0,roceP2p1s0f0  # BOTH RoCE twins — one alone caps NCCL at ~100G
MASTER_PORT=29501            # vLLM multi-node rendezvous (head)

# NCCL_IB_GID_INDEX is deliberately absent — and deliberately never set.
# NCCL >= 2.21 selects the RoCEv2/IPv4 GID itself when the index is unset;
# a stored index rots when the kernel renumbers the table (docs/00).

# --- paths -------------------------------------------------------------------
HF_CACHE=$HOME/dgx/hf        # HuggingFace cache root — identical path on both nodes

# --- serving -----------------------------------------------------------------
API_PORT=8000
IMAGE=dgx-spark-serve:dev    # built by scripts/build.sh, copied to the worker
