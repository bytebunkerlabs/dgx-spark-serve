#!/usr/bin/env bash
# rack — serve models on DGX Spark, NVIDIA Linux, Windows (WSL2) and Mac.
#
#   rack init                  detect this machine, import .env, write the inventory
#   rack nodes add|ls|rm|test  the machines in this rack
#   rack fit  <hf-id>          will it fit? (asks HuggingFace, does the arithmetic)
#   rack pull <recipe|hf-id>   download + replicate to the workers + verify
#   rack new  <name> <hf-id>   scaffold a recipe you can edit
#   rack up   <recipe>         launch (solo or TP=2, from the recipe)
#
# pull, up, fit, recipes and new take a platform flag (--dgx, --linux,
# --windows, --mac; default: this machine's) and --plan; any command but init
# and nodes takes --on <node> to run it on another machine of the inventory.
#   rack down                  stop everything
#   rack status                what's running, on both nodes
#   rack logs [-f]             head and worker logs
#   rack bench [label]         measure the running model
#   rack chat  <text>          one-shot completion against it
#   rack monitor up            telemetry for every node, one endpoint for the app
#
# Install:  ./rack install     (symlinks into ~/.local/bin or /usr/local/bin)
set -euo pipefail

# resolve through the symlink so the repo can live anywhere
SELF=${BASH_SOURCE[0]}
while [ -L "$SELF" ]; do SELF=$(readlink "$SELF"); done
ROOT=$(cd "$(dirname "$SELF")" && pwd)
cd "$ROOT"
. "$ROOT/lib/common.sh"
. "$ROOT/lib/platform.sh"
. "$ROOT/lib/inventory.sh"
. "$ROOT/lib/nodes.sh"
. "$ROOT/lib/flags.sh"
. "$ROOT/lib/recipe.sh"
RACK_ROOT=$ROOT
load_site_env
SITE_IMAGE=${IMAGE:-}                        # the site's image, if it named one (else per platform)
HF_CACHE=${HF_CACHE:-$HOME/dgx/hf}
IMAGE=${IMAGE:-dgx-spark-serve:dev}
API_PORT=${API_PORT:-8888}
TEMPLATE=${TEMPLATE:-recipes/TEMPLATE.env}   # what `rack new` scaffolds from

# Who is the head, who are the workers, and are we typing on the head or
# driving it from a laptop? Both are supported, and the difference is not
# cosmetic: `docker ps` and `free` on a laptop describe the laptop. The
# inventory (rack init, rack nodes) answers; lib/inventory.sh has the rules
# for a machine that has none yet.
rack_resolve_site

# Empty WORKER_NAMES = a single-box site: no worker exists, so no command pays
# a 5 s ssh timeout per worker discovering that.
have_worker() { [ -n "$WORKER_NAMES" ]; }
run_on_head() {  # bash -c locally so quoting matches the ssh path exactly
  if [ "$IS_HEAD" = 1 ]; then bash -c "$1"; else ssh -n "$HEAD_SSH" "$1"; fi
}
# The monitor launcher reads the resolved site, not its own defaults.
monitor_env() {
  HEAD_IP="${HEAD_IP:-}" HEAD_LABEL="$HEAD_LABEL" WORKER_SSH="$WORKER_SSH" WORKER_IP="${WORKER_IP:-}" \
    RACK_IS_HEAD="$IS_HEAD" "$@"
}
# A path built from the laptop's $HOME is not the node's path. Keep $HOME
# literal so whichever shell finally runs it expands its own.
remote_path() { printf '%s' "${1/#$HOME/\$HOME}"; }

# Run a rack script on a worker, from its own checkout. The worker learns the
# fabric facts from the head's inventory, so it needs no .env of its own.
on_worker_script() { # on_worker_script <name> <script> [args...]
  local n=$1 script=$2 envs; shift 2
  envs="HEAD_IP=$(printf %q "${HEAD_IP:-}") WORKER_IP=$(printf %q "$(inv_get "$n" NODE_FABRIC_IP)")"
  [ -n "$(inv_get "$n" NODE_FABRIC_IF)" ] && envs="$envs FABRIC_IF=$(printf %q "$(inv_get "$n" NODE_FABRIC_IF)")"
  [ -n "$(inv_get "$n" NODE_IB_HCAS)" ] && envs="$envs IB_HCAS=$(printf %q "$(inv_get "$n" NODE_IB_HCAS)")"
  local args=""; [ $# -gt 0 ] && args=$(printf '%q ' "$@")
  ssh -n "$(node_ssh "$n")" "cd $(printf %q "$(node_rack_dir "$n")") && $envs bash scripts/$script $args"
}

usage() {
  cat <<'EOF'
rack — serve models on DGX Spark, NVIDIA Linux, Windows (WSL2) and Mac

  rack init [--name <n>]      detect this machine, import .env, write the inventory
  rack version [--json]       this rack's version and schemas
  rack platform [--json]      what this machine is: dgx, linux, windows (WSL2) or mac
  rack nodes [ls] [--json]    the machines in this rack
  rack nodes add <name> [--ssh <target>] [--fabric <ip>] [--role worker|node] ...
  rack nodes rm <name>        forget a machine (touches nothing on it)
  rack nodes test [<name>...] [--json]   ssh, platform, rack installed, fabric
  rack fit <hf-id>            will it fit? asks HuggingFace, does the arithmetic
  rack pull <recipe|hf-id>    download, replicate to the workers, verify shards
  rack models                 what's on disk, and where
  rack new <name> <hf-id>     scaffold recipes/<name>.env
  rack recipes                list recipes, and the platforms each serves on

  rack build [community|ngc|upstream]   build the image and ship it to the workers
  rack preflight              read-only health check, every node
  rack up <recipe>            launch — solo or TP=2, whichever the recipe says
  rack down                   stop serving on every node
  rack status                 containers, memory, API health
  rack logs [-f] [<node>|worker]   engine logs
  rack bench [label]          measure the running model
  rack chat <text>            one-shot completion
  rack net                    does the engine talk to the internet? verdict, every node
  rack scrub [--delete]       every trace a video run leaves: list, or wipe
  rack monitor up|down|status|token|logs
                              telemetry for every node behind one endpoint (docs/11-monitor.md)

  --dgx --linux --windows --mac   pull, up, fit, recipes, new: that platform's variant
                              (default: this machine's; another is refused with the fix)
  --plan                      pull, up: print what would run, run nothing (any machine)
  --on <node>                 any command but init and nodes: run it on that node

Recipes live in recipes/. The inventory is ~/.config/dgx-serve/nodes (rack init);
site settings are ~/.config/dgx-serve/rack.env, or .env here. Everything is idempotent.
EOF
}

# ------------------------------------------------------------ version ------
# What this rack is, for people and for the app's compatibility check (and for
# --on, which refuses to forward to a rack that cannot answer this).
cmd_version() {
  local commit
  commit=$(git -C "$ROOT" rev-parse --short HEAD 2>/dev/null || true)
  if [ "${1:-}" = --json ]; then
    printf '{"schema":%s,"version":%s,"commit":%s,"json_schema":%s,"recipe_schema":%s,"platforms":["dgx","linux","windows","mac"]}\n' \
      "$RACK_JSON_SCHEMA" "$(json_str "$RACK_VERSION")" "$(json_str "$commit")" "$RACK_JSON_SCHEMA" "$RACK_RECIPE_SCHEMA"
    return
  fi
  printf 'rack %s%s (recipes v%s, json v%s)\n' "$RACK_VERSION" "${commit:+ $commit}" "$RACK_RECIPE_SCHEMA" "$RACK_JSON_SCHEMA"
}

# ----------------------------------------------------------- platform ------
cmd_platform() {
  platform_detect
  if [ "${1:-}" = --json ]; then platform_json; return; fi
  platform_support_check
  bold "$(platform_describe)"
  printf '  platform   %s\n' "$PLATFORM"
  [ -n "$PLAT_OS_NAME" ] && printf '  system     %s, %s\n' "$PLAT_OS_NAME" "$PLAT_ARCH"
  [ -n "$PLAT_CPU" ] && printf '  cpu        %s\n' "$PLAT_CPU"
  local i=1
  while [ "$i" -le "$PLAT_GPU_COUNT" ]; do
    printf '  gpu %-6s %s, %s MiB, compute %s\n' "$((i - 1))" "$(printf '%s' "$PLAT_GPU_NAMES" | cut -d';' -f"$i")" \
      "$(printf '%s' "$PLAT_GPU_MEM_MB" | cut -d, -f"$i")" "$(printf '%s' "$PLAT_GPU_CC" | cut -d, -f"$i")"
    i=$((i + 1))
  done
  [ "$PLATFORM" = unsupported ] || printf '  models     about %s GiB of memory to work with\n' "$(( ($(platform_model_budget_mb) + 512) / 1024 ))"
  case "$PLATFORM" in
    dgx|linux|windows) printf '  runtime    docker %s, NVIDIA container toolkit %s, %s\n' \
      "$([ "$PLAT_DOCKER" = 1 ] && echo yes || echo no)" "$([ "$PLAT_NVIDIA_RUNTIME" = 1 ] && echo yes || echo no)" "$PLAT_INIT" ;;
    mac) printf '  runtime    native (launchd)\n' ;;
  esac
  if [ "$PLAT_SUPPORTED" = 1 ]; then printf '  supported  yes\n'; else printf '  supported  no: %s\n' "${PLAT_SUPPORT_NOTE:-$PLAT_REASON}"; fi
}

# ---------------------------------------------------------------- fit ------
cmd_fit() {
  flags_parse "$@"
  set -- ${REST[@]+"${REST[@]}"}
  [ $# -gt 0 ] || die "usage: rack fit <recipe|org/model> [--dgx|--linux|--windows|--mac]"
  flags_target fit
  local id; id=$(model_ref "$1")
  bold "$id"
  python3 - "$id" "${USABLE_GB:-110}" <<'PY'
import json, sys, urllib.request
mid, usable = sys.argv[1], float(sys.argv[2])
def get(u):
    with urllib.request.urlopen(u, timeout=60) as r: return json.load(r)
try:
    api = get(f"https://huggingface.co/api/models/{mid}?blobs=true")
except Exception as e:
    sys.exit(f"  could not reach HuggingFace: {e}")
sib = api.get("siblings") or []
disk = sum(s.get("size") or 0 for s in sib)
shards = sum(1 for s in sib if s["rfilename"].endswith(".safetensors"))
st = (api.get("safetensors") or {})
total = st.get("total") or 0
gb = disk / 1e9
print(f"  download    {gb:,.1f} GB across {shards} shards")
if total:
    print(f"  parameters  {total/1e9:,.1f} B   ({disk*8/total:.2f} effective bpw)")
# active params, when the config exposes MoE geometry
try:
    c = get(f"https://huggingface.co/{mid}/raw/main/config.json")
    t = c.get("text_config", c)
    H, L = t.get("hidden_size"), t.get("num_hidden_layers")
    routed = t.get("n_routed_experts") or t.get("num_experts") or t.get("num_local_experts")
    if H and L and routed:
        top = (t.get("num_experts_per_tok") or t.get("num_experts_per_token") or 2)
        sh = (t.get("n_shared_experts") or t.get("num_shared_experts") or 0)
        mi = t.get("moe_intermediate_size") or t.get("intermediate_size")
        w = t.get("routed_expert_hidden_size") or H
        dense = t.get("first_k_dense_replace") or 0
        ml = L - dense
        act = (top + sh) * 3 * w * mi * ml
        print(f"  active/token ~{act/1e9:,.1f} B in experts  ({top} routed + {sh} shared of {routed})")
    ctx = t.get("max_position_embeddings")
    if ctx: print(f"  context     {ctx:,}")
except Exception:
    pass
print()
for nodes in (1, 2):
    budget = usable * nodes - 20
    ok = gb <= budget
    mark = "fits" if ok else "does not fit"
    print(f"  {nodes} node{'s' if nodes>1 else ' '}: {gb:,.0f} GB vs {budget:,.0f} GB budget "
          f"({usable:g} x {nodes} - 20 reserve)  ->  {mark}")
print("\n  budget assumes 20 GB held back for KV cache and runtime.")
print("  more at https://fits.bytebunkerlabs.ai")
PY
}

# --------------------------------------------------------------- pull ------
# A Hugging Face repo id from a command's argument: an org/name as given, or
# the MODEL of a recipe's variant for the target platform.
model_ref() {
  local ref=$1 id
  case "$ref" in
    */*) printf '%s' "$ref"; return ;;
  esac
  recipe_resolve "$ref" "$TARGET_PLATFORM"
  id=$(recipe_model "$RECIPE_FILE")
  case "$id" in
    /*|'(none declared)'|'(inheritance loop)'|'') die "$RECIPE_NAME's MODEL is not a Hugging Face repo ($id): nothing to fetch" ;;
  esac
  printf '%s' "$id"
}

cmd_pull() {
  flags_parse "$@"
  set -- ${REST[@]+"${REST[@]}"}
  [ $# -gt 0 ] || die "usage: rack pull <recipe|org/model> [--dgx|--linux|--windows|--mac] [--plan]"
  flags_target pull
  local id; id=$(model_ref "$1")
  if [ "$PLAN" = 1 ]; then
    if [ "$JSON" = 1 ]; then
      printf '{"schema":%s,"command":"pull","platform":%s,"model":%s,"cache":%s,"replicate_to":%s}\n' "$RACK_JSON_SCHEMA" \
        "$(json_str "$TARGET_PLATFORM")" "$(json_str "$id")" "$(json_str "$HF_CACHE")" "$(json_str "$WORKER_NAMES")"
    else
      bold "plan: rack pull $1 --$TARGET_PLATFORM (nothing was run)"
      printf '  model      %s\n  into       %s\n' "$id" "$HF_CACHE"
      [ -z "$WORKER_NAMES" ] || printf '  then       replicate to %s, verify shards on every node\n' "$WORKER_NAMES"
    fi
    return
  fi
  case "$TARGET_PLATFORM" in
    windows|mac) die "downloading for $(platform_title "$TARGET_PLATFORM") needs rack's own downloader, which is not in this build yet" ;;
  esac
  docker image inspect "$IMAGE" >/dev/null 2>&1 || die "image $IMAGE missing — run: rack build"
  bold "downloading $id"
  docker run --rm -v "$HF_CACHE:/root/.cache/huggingface" --entrypoint bash "$IMAGE" \
    -c "hf download '$id'"
  # The container downloads as root; anything it creates 600 (hub metadata
  # like trees/*.json) is unreadable to the host user and kills the rsync
  # replication mid-flight (measured: exit 23, and set -e then skips shard
  # verification — the worst part). Hand the tree back before syncing.
  docker run --rm -v "$HF_CACHE:/cache" --entrypoint chown "$IMAGE" \
    -R "$(id -u):$(id -g)" "/cache/hub/models--${id//\//--}"
  if have_worker; then
    bold "replicating to $WORKER_NAMES over the fabric"
    "$ROOT/scripts/sync-model.sh" "$id" || warn "replication failed: fix it, then scripts/sync-model.sh $id"
  fi
  cmd_verify "$id"
}

cmd_verify() {
  local id=${1:?} dir="models--${1//\//--}"
  bold "verifying shards"
  local script="
import json,glob,os,sys
g=glob.glob(os.path.expanduser('$HF_CACHE/hub/$dir/snapshots/*/'))
if not g: print('  MISSING on this node'); sys.exit(1)
p=g[0]; f=p+'model.safetensors.index.json'
if not os.path.exists(f): print('  single-file model, no index'); sys.exit(0)
i=json.load(open(f)); s=sorted(set(i['weight_map'].values()))
m=[x for x in s if not os.path.exists(p+x)]
print(f'  {len(s)} shards, {len(m)} missing')
sys.exit(1 if m else 0)"
  local me n; me=$(local_label)
  printf '  %s: ' "$me"; python3 -c "$script" || die "incomplete on $me"
  for n in $WORKER_NAMES; do
    printf '  %s: ' "$n"
    node_up "$n" || { echo "unreachable over ssh"; die "could not verify $n"; }
    ssh -n "$(node_ssh "$n")" "python3 -c \"$script\"" || die "incomplete on $n"
  done
}

cmd_models() {
  bold "on disk"
  # The cache lives on the nodes. Asking the laptop's filesystem about it
  # answers a different question and the answer looks like "nothing cached".
  local out rc cache; cache=$(remote_path "$HF_CACHE")
  out=$(run_on_head "for d in $cache/hub/models--*; do [ -d \"\$d\" ] || continue;
        n=\${d##*/models--}; printf '  %-52s %s\n' \"\${n//--//}\" \"\$(du -sh \"\$d\" 2>/dev/null | cut -f1)\"; done") \
    && rc=0 || rc=$?
  if [ "$rc" -ne 0 ]; then
    dim "  UNKNOWN — could not read $HF_CACHE on $HEAD_LABEL"
  elif [ -n "$out" ]; then
    printf '%s\n' "$out"
  else
    dim "  nothing cached yet — try: rack pull <org/model>"
  fi
}

# The file a recipe sources, other than its model.env: a flat parent
# (`. recipes/parent.env`) or a sibling variant (`. "$RECIPE_DIR/dgx.env"`).
recipe_parent() {
  local p
  p=$(sed -n 's|^\. *\(recipes/[^ ]*\.env\).*|\1|p' "$1" | head -1)
  [ -n "$p" ] && { printf '%s' "$p"; return; }
  # shellcheck disable=SC2016  # $RECIPE_DIR is the text being matched
  p=$(sed -n 's|^\. *"\$RECIPE_DIR/\([A-Za-z0-9._-]*\.env\)".*|\1|p' "$1" | grep -v '^model\.env$' | head -1 || true)
  [ -n "$p" ] && printf '%s/%s' "$(dirname "$1")" "$p"
  return 0
}

# MODEL= of a recipe, following `. recipes/parent.env` inheritance. A variant
# recipe (h3-spark2-sage) declares no MODEL of its own — that is the layering
# working, so read through to the parent rather than reporting nothing.
recipe_model() {
  local f=$1 depth=${2:-0} m parent
  [ "$depth" -gt 4 ] && { printf '(inheritance loop)'; return; }
  m=$(grep -m1 '^MODEL=' "$f" | cut -d= -f2- || true)
  [ -n "$m" ] && { printf '%s' "$m"; return; }
  # a v2 variant: what it shares is in its folder's model.env
  [ "$(basename "$f")" != model.env ] && [ -f "$(dirname "$f")/model.env" ] \
    && { recipe_model "$(dirname "$f")/model.env" $((depth + 1)); return; }
  parent=$(recipe_parent "$f")
  [ -n "$parent" ] && [ -e "$parent" ] && { recipe_model "$parent" $((depth + 1)); return; }
  printf '%s' '(none declared)'
}

cmd_recipes() {
  [ "${1:-}" = check ] && { shift; recipes_check "$@"; return; }
  flags_parse "$@"
  [ ${#REST[@]} -eq 0 ] || die "usage: rack recipes [--dgx|--linux|--windows|--mac] [--json] | rack recipes check [<name>...]"
  local here budget names json=""
  [ "$JSON" = 1 ] && json=--json
  here=$(this_platform)
  platform_detect
  budget=$(platform_model_budget_mb)
  names=$(recipe_names)
  if [ "$JSON" != 1 ]; then
    if [ -z "$WANT_PLATFORM" ]; then bold "recipes"
    elif [ "$WANT_PLATFORM" = "$here" ]; then
      bold "recipes for $(platform_title "$here") that fit here (about $(( (budget + 512) / 1024 )) GiB for models)"
    else bold "recipes for $(platform_title "$WANT_PLATFORM")"; fi
    [ -n "$names" ] || { dim "  none yet — try: rack new <name> <org/model>${WANT_PLATFORM:+ --$WANT_PLATFORM}"; return 0; }
  fi
  # shellcheck disable=SC2086  # names are recipe names: no spaces
  recipe_index $names | python3 "$ROOT/py/recipes.py" list --root "$ROOT" --here "$here" --budget-mb "${budget:-0}" \
    ${WANT_PLATFORM:+--platform "$WANT_PLATFORM"} ${json:+"$json"}
}

# The check, for what recipe_resolve just found (a name or a path): that
# variant and what it sources.
check_resolved() {
  local loc=$RECIPE_FILE
  case "$(basename "$RECIPE_FILE")" in
    dgx.env|linux.env|windows.env|mac.env) [ -f "$RECIPE_DIR/model.env" ] && loc=$RECIPE_DIR ;;
  esac
  printf '%s\t%s\trepo\n' "$RECIPE_NAME" "$loc" \
    | python3 "$ROOT/py/recipes.py" check --root "$ROOT" --platform "$TARGET_PLATFORM"
}

# rack recipes check [<name>...]: what may be in a recipe, and whether each
# variant has what its engine needs. Errors fail; warnings do not.
recipes_check() {
  local names="" n
  if [ $# -gt 0 ]; then
    for n in "$@"; do names="$names $(recipe_name_of "$n")"; done
  else
    names=$(recipe_names)
  fi
  # shellcheck disable=SC2086  # names are recipe names: no spaces
  recipe_index $names | python3 "$ROOT/py/recipes.py" check --root "$ROOT"
}

# ---------------------------------------------------------------- new ------
# rack new <name> <org/model> [--<platform>]: a recipe folder, recipes/<name>/,
# with model.env and this platform's variant (default: this machine's). For an
# existing recipe it adds that platform's variant; a flat recipe from before
# 1.0 first becomes a folder, its file kept as dgx.env (and linux.env still
# serving it on NVIDIA Linux, as before). New recipes go into the checkout when
# rack runs from a git checkout (to commit), else into your own recipes,
# ~/.config/dgx-serve/recipes, which updates never touch.
cmd_new() {
  flags_parse "$@"
  set -- ${REST[@]+"${REST[@]}"}
  { [ $# -ge 1 ] && [ $# -le 2 ]; } || die "usage: rack new <name> <org/model> [--dgx|--linux|--windows|--mac]"
  local name=$1 id=${2:-} plat dir loc tmpl variant model
  inv_valid_name "$name" || die "recipe names are letters, digits, dot, dash and underscore: '$name'"
  case "$name" in TEMPLATE*) die "TEMPLATE names the scaffolds: pick another name" ;; esac
  [ -z "$id" ] || case "$id" in */*) ;; *) die "the model is a Hugging Face id, org/name (got: $id)" ;; esac
  plat=${WANT_PLATFORM:-$(this_platform)}
  case "$plat" in dgx|linux|windows|mac) ;;
    *) die "this machine is not one rack serves on: say which platform (--dgx, --linux, --windows or --mac)" ;; esac
  case "$plat" in dgx|linux) tmpl=$ROOT/recipes/TEMPLATE.env ;; *) tmpl=$ROOT/recipes/TEMPLATE-llamacpp.env ;; esac
  [ -f "$tmpl" ] || die "missing $tmpl — the scaffold lives there, not in this script"
  loc=$(recipe_location "$name")
  case "$loc" in
    '')
      [ -n "$id" ] || die "a new recipe needs its model: rack new $name <org/model> --$plat"
      case "$plat:$id" in mac:*-GGUF|mac:*-gguf|windows:*-GGUF|windows:*-gguf) model=${id%-[Gg][Gg][Uu][Ff]} ;; *) model=$id ;; esac
      dir=$(new_recipe_home)/$name
      mkdir -p "$dir"
      new_model_env "$name" "$model" > "$dir/model.env" ;;
    *.env) dir=$(flat_to_folder "$name" "$loc") ;;
    *) dir=$loc ;;
  esac
  model=$(recipe_model "$dir/model.env")
  variant=$dir/$plat.env
  [ -e "$variant" ] && die "$variant already exists"

  # Header of our own, then the template from its first question down. The
  # template's preamble is guidance for the author and does not belong in a
  # recipe; docs/05-recipe-method.md is the long form.
  local fit=${id:-$model} artifact=""
  case "$plat:$id" in mac:*-GGUF|mac:*-gguf|windows:*-GGUF|windows:*-gguf) artifact=$id/FILL_ME.gguf ;; esac
  { printf '# %s on %s — scaffolded %s by: rack new\n' "$name" "$(platform_title "$plat" | sed 's/^an* //')" "$(date +%Y-%m-%d)"
    printf '# Answer the questions in order. A flag with no reason is a flag\n'
    printf '# nobody can safely delete later.  docs/05-recipe-method.md\n\n'
    sed -n '/^# --- 1 FIT/,$p' "$tmpl" \
      | sed -e "s|^#     rack fit <org/model>.*$|#     rack fit $fit --$plat|" \
            -e "s|^ARTIFACT=FILL_ME$|ARTIFACT=${artifact:-FILL_ME}|" \
            -e "s|rack up <name> --mac|rack up $name --$plat|" \
            -e "s|rack up <name>|rack up $name|"
  } > "$variant"

  bold "wrote $variant"
  dim "  1. rack fit $fit --$plat      then record the verdict in the file"
  dim "  2. edit it, in order, top to bottom (and $(basename "$dir")/model.env: roles, dialect)"
  dim "  3. rack recipes check $name"
  dim "  4. rack up $name --$plat"
}

# Where a new recipe goes: the checkout when it is a git work tree (yours to
# commit), else your own recipes, outside the install.
new_recipe_home() {
  if git -C "$ROOT" rev-parse --is-inside-work-tree >/dev/null 2>&1; then printf '%s/recipes' "$ROOT"
  else mkdir -p "$DGX_SERVE_CONFIG/recipes"; printf '%s/recipes' "$DGX_SERVE_CONFIG"; fi
}

new_model_env() { # new_model_env <name> <org/model>
  cat <<EOF
# $1 — what every platform shares. Scaffolded $(date +%Y-%m-%d) by: rack new
# The platform files (dgx.env, linux.env, windows.env, mac.env) source this.

# --- 3 ACCESS: the model, as Hugging Face names it. Gated? Say how you got in.
MODEL=$2

# What the app may send it: chat tools reasoning vision code embedding rerank draft
ROLES="chat"

# --- 5 DIALECT, the per-request half: what a client must do for correct
# answers. The app reads these; leave out what does not apply.
# DIALECT_THINKING=          how thinking is switched, e.g. chat_template_kwargs.enable_thinking
# DIALECT_EFFORT=            how effort is set, e.g. reasoning_effort
# DIALECT_STRIP_REASONING=1  earlier turns' reasoning stays out of the history
# DIALECT_ECHO_REASONING=1   reasoning_content must be sent back (DeepSeek, with tools)
# DIALECT_MIN_MAX_TOKENS=    a max_tokens floor, for models that think at length (GLM)
# DIALECT_SAMPLING=          the vendor's sampling, e.g. "temperature=0.6 top_p=0.95"
EOF
}

# recipes/<name>.env (flat, before 1.0) -> recipes/<name>/: the file becomes
# dgx.env (git mv when tracked, so history follows), model.env names the
# model, and linux.env keeps serving it on NVIDIA Linux with the same flags.
flat_to_folder() { # flat_to_folder <name> <file>; prints the folder
  local name=$1 file=$2 dir model
  dir=${file%.env}
  model=$(recipe_model "$file")
  mkdir -p "$dir"
  if git -C "$(dirname "$file")" ls-files --error-unmatch "$(basename "$file")" >/dev/null 2>&1; then
    git -C "$(dirname "$file")" mv "$(basename "$file")" "$name/dgx.env"
  else
    mv "$file" "$dir/dgx.env"
  fi
  new_model_env "$name" "$model" > "$dir/model.env"
  # shellcheck disable=SC2016  # the line written must say $RECIPE_DIR, unexpanded
  printf '# %s on NVIDIA Linux: the flags of dgx.env, as before recipes v2.\n# Re-answer the site questions for your GPU (docs/05-recipe-method.md).\n. "$RECIPE_DIR/dgx.env"\n' \
    "$name" > "$dir/linux.env"
  warn "$name was one file; it is now the folder $dir (dgx.env, linux.env, model.env)"
  printf '%s' "$dir"
}

# --------------------------------------------------------- lifecycle ------
cmd_build()     { "$ROOT/scripts/build.sh" --profile "${1:-community}"; }
cmd_preflight() {
  local n
  bold "$(local_label)"; "$ROOT/scripts/preflight.sh" || true
  for n in $WORKER_NAMES; do
    echo; bold "$n"
    if node_up "$n"; then on_worker_script "$n" preflight.sh || true
    else dim "  unreachable over ssh ($(node_ssh "$n"))"; fi
  done
}

cmd_up() {
  flags_parse "$@"
  local replace="" boot="" debug="" a r
  set --
  for a in ${REST[@]+"${REST[@]}"}; do
    case "$a" in
      --replace) replace=--replace ;;
      --boot) boot=--boot replace=--replace ;;
      --debug) debug=1 ;;
      -*) die "rack up: unknown option $a  (rack --help)" ;;
      *) set -- "$@" "$a" ;;
    esac
  done
  [ $# -eq 1 ] || die "usage: rack up <recipe> [--dgx|--linux|--windows|--mac] [--plan [--json]] [--replace] [--on <node>]"
  r=$1
  flags_target up
  recipe_resolve "$r" "$TARGET_PLATFORM"
  local f=$RECIPE_FILE
  # Recipes are sourced: one that does more than assign variables never is.
  check_resolved >/dev/null || { check_resolved >&2 || true; die "$RECIPE_NAME fails rack recipes check: fix it first"; }
  if [ "$PLAN" != 1 ]; then
    # A scaffolded recipe that was never finished would otherwise reach the
    # engine as a bare `--max-model-len --max-num-seqs` and fail somewhere less obvious.
    grep -qs 'FILL_ME' "$f" "$RECIPE_DIR/model.env" \
      && die "$f still has FILL_ME placeholders — answer its questions (docs/05-recipe-method.md)"
    [ "$IS_HEAD" = 1 ] || die "rack up runs on the machine that serves: rack up $r --on $HEAD_LABEL"
    ensure_engine_key
  fi
  platform_detect
  local pf=(); [ "$PLAN" = 1 ] && pf+=(--plan); [ "$JSON" = 1 ] && pf+=(--json)
  RACK_DEBUG=$debug serve_py up --recipe-name "$RECIPE_NAME" --recipe-file "$f" --recipe-dir "$RECIPE_DIR" \
    --platform "$TARGET_PLATFORM" --facts "$(platform_json)" ${replace:+"$replace"} ${boot:+"$boot"} \
    ${pf[@]+"${pf[@]}"}
}

cmd_down() {
  flags_parse "$@"
  [ ${#REST[@]} -eq 0 ] || die "usage: rack down [--plan [--json]] [--on <node>]"
  [ "$PLAN" = 1 ] || [ "$IS_HEAD" = 1 ] || die "rack down runs on the machine that serves: rack down --on $HEAD_LABEL"
  platform_detect
  local pf=(); [ "$PLAN" = 1 ] && pf+=(--plan); [ "$JSON" = 1 ] && pf+=(--json)
  serve_py down ${pf[@]+"${pf[@]}"}
}

# py/serve.py, with the site in its environment: the nodes (head first) and
# every setting that shapes a launch.
serve_py() {
  RACK_ROOT=$ROOT RACK_VERSION=$RACK_VERSION HF_CACHE=$HF_CACHE API_PORT=$API_PORT SITE_IMAGE=$SITE_IMAGE \
  ENGINE_BIND=${ENGINE_BIND:-} ENGINE_KEY=${ENGINE_KEY:-on} MASTER_PORT=${MASTER_PORT:-29501} \
  MEM_CAP_GB=${MEM_CAP_GB:-} FOREIGN_ENGINES=${FOREIGN_ENGINES:-} MEMWATCH_KILL=${MEMWATCH_KILL:-0} \
  TOPOLOGY=${TOPOLOGY:-auto} HEAD_LABEL=$HEAD_LABEL DGX_SERVE_CONFIG=$DGX_SERVE_CONFIG \
  DGX_SERVE_STATE=$DGX_SERVE_STATE RACK_NODES="$(rack_nodes_lines)" python3 "$ROOT/py/serve.py" "$@"
}

# One line per node for py/serve.py, the head (this machine) first:
# name, ssh, fabric ip, fabric interface, HCAs, rack dir, HF cache, platform, GPUs.
rack_nodes_lines() {
  local n first=${WORKER_NAMES%% *} ip
  printf '%s\t\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$HEAD_LABEL" "${HEAD_IP:-}" "${FABRIC_IF:-}" "${IB_HCAS:-}" \
    "$ROOT" "$HF_CACHE" "$(this_platform)" "${PLAT_GPU_COUNT:-0}"
  for n in $WORKER_NAMES; do
    ip=$(inv_get "$n" NODE_FABRIC_IP)
    [ -n "$ip" ] || [ "$n" != "$first" ] || ip=${WORKER_IP:-}
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$n" "$(node_ssh "$n")" "$ip" "$(inv_get "$n" NODE_FABRIC_IF)" \
      "$(inv_get "$n" NODE_IB_HCAS)" "$(node_rack_dir "$n")" "$(node_hf_cache "$n")" \
      "$(inv_get "$n" NODE_PLATFORM)" "$(inv_get "$n" NODE_GPUS)"
  done
}

# The engine's API key, made on first use when rack init never ran.
ensure_engine_key() {
  case "${ENGINE_KEY:-on}" in off|0|no|none) return 0 ;; esac
  [ -s "$ENGINE_KEY_FILE" ] || { write_secret "$ENGINE_KEY_FILE" "$(new_secret)"; dim "  new engine key in $ENGINE_KEY_FILE"; }
  [ -s "$ENGINE_ENV_FILE" ] || write_secret "$ENGINE_ENV_FILE" "VLLM_API_KEY=$(cat "$ENGINE_KEY_FILE")"
}

# Report a node line, distinguishing "nothing running" from "could not look".
# Reporting the second as the first is how you launch a model on top of one
# that is already resident. `out`/`rc` come from node_probe.
node_probe() {   # node_probe <label> <remote-cmd> ; sets PROBE_OUT / PROBE_RC
  local label=$1 cmd=$2
  if [ "$label" = "$HEAD_LABEL" ]; then
    PROBE_OUT=$(run_on_head "$cmd" 2>/dev/null) && PROBE_RC=0 || PROBE_RC=$?
  else
    PROBE_OUT=$(ssh -n "$(node_ssh "$label")" "$cmd" 2>/dev/null) && PROBE_RC=0 || PROBE_RC=$?
  fi
}

# A field of what rack up recorded as serving here (state/serving.json).
serving_get() {
  python3 -c 'import json,sys
try: v=json.load(open(sys.argv[1])).get(sys.argv[2])
except Exception: v=None
print("" if v is None else (" ".join(v) if isinstance(v,list) else v))' "$DGX_SERVE_STATE/serving.json" "$1"
}

cmd_status() {
  local n runtime
  runtime=$([ "$IS_HEAD" = 1 ] && serving_get runtime || true)
  if [ -n "$runtime" ]; then
    bold "serving"
    printf '  %s (%s) with %s under %s on %s, since %s\n' "$(serving_get recipe)" "$(serving_get model)" \
      "$(serving_get engine)" "$runtime" "$(serving_get nodes)" "$(serving_get started_at)"
    case "$runtime" in
      launchd) launchctl print "gui/$(id -u)/ai.bytebunker.dgx-serve.engine" 2>/dev/null | grep -q 'state = running' \
                 && printf '  engine process running (launchd)\n' || dim "  engine process not running: rack logs" ;;
      systemd) printf '  engine unit %s\n' "$(systemctl --user is-active dgx-serve-engine.service 2>/dev/null || echo inactive)" ;;
    esac
    echo
  fi
  if [ "$runtime" = launchd ] || { [ "$runtime" = systemd ] && ! have docker; }; then
    status_api; return
  fi
  bold "containers"
  for n in "$HEAD_LABEL" $WORKER_NAMES; do
    [ "$n" = "$HEAD_LABEL" ] || node_up "$n" || { dim "  $n  unreachable over ssh"; continue; }
    node_probe "$n" "docker ps --format '{{.Names}}  {{.Status}}'"
    if [ "$PROBE_RC" -ne 0 ]; then
      dim "  $n  UNKNOWN — could not run docker there (not 'nothing serving')"
    elif printf '%s\n' "$PROBE_OUT" | grep -qE 'serve_'; then
      printf '%s\n' "$PROBE_OUT" | grep -E 'serve_' | sed "s/^/  $n  /"
    else
      dim "  $n  nothing serving"
    fi
  done

  echo; bold "memory"
  for n in "$HEAD_LABEL" $WORKER_NAMES; do
    [ "$n" = "$HEAD_LABEL" ] || node_up "$n" || continue
    node_probe "$n" "free -g | awk '/^Mem:/{printf \"%s GiB used, %s GiB available\", \$3, \$7}'"
    if [ "$PROBE_RC" -ne 0 ] || [ -z "$PROBE_OUT" ]; then
      dim "  $n  UNKNOWN — could not read free(1) there"
    else
      printf '  %s  %s\n' "$n" "$PROBE_OUT"
    fi
    # free(1) is truth on unified memory; nvidia-smi cannot see these bytes.
  done

  echo
  status_api
}

status_api() {
  bold "api"
  local m port k
  port=$([ "$IS_HEAD" = 1 ] && serving_get port || true)
  port=${port:-$API_PORT}
  k=$(remote_path "$ENGINE_KEY_FILE")
  # Ask on the head — from a laptop, 127.0.0.1 is the laptop. The key goes in
  # through a header file, never on a command line.
  if m=$(run_on_head "k=$k; if [ -s \"\$k\" ]; then curl -s --max-time 5 -H @<(printf 'Authorization: Bearer %s\\n' \"\$(cat \"\$k\")\") http://127.0.0.1:$port/v1/models; else curl -s --max-time 5 http://127.0.0.1:$port/v1/models; fi" 2>/dev/null) && [ -n "$m" ]; then
    printf '%s' "$m" | python3 -c "
import json,sys
try: d=json.load(sys.stdin)
except Exception: print('  not answering yet'); sys.exit()
ms=[x['id'] for x in d.get('data',[])]
print('  serving: ' + (', '.join(ms) if ms else 'no models'))" 2>/dev/null || dim "  not answering yet"
  else
    dim "  :$port on $HEAD_LABEL not answering (still loading, or nothing running)"
  fi

  echo; bold "monitor"
  monitor_env "$ROOT/monitor/rack-monitor.sh" brief 2>/dev/null || dim "  unknown: rack monitor status"
}

cmd_logs() {
  local follow="" who="" a cmd
  for a in "$@"; do
    case "$a" in
      -f|--follow) follow="-f" ;;
      worker) who=${WORKER_NAMES%% *}; [ -n "$who" ] || die "this rack has no worker (rack nodes)" ;;
      -*) die "usage: rack logs [-f] [<node>|worker]" ;;
      *) who=$a ;;
    esac
  done
  [ "$who" = "$HEAD_LABEL" ] && who=""
  local log; log=$([ -z "$who" ] && [ "$IS_HEAD" = 1 ] && serving_get log || true)
  if [ -n "$log" ]; then                     # llama.cpp or a venv under launchd/systemd
    [ -f "$log" ] || die "no log yet at $log (rack status)"
    if [ -n "$follow" ]; then exec tail -n 60 -F "$log"; else tail -n 60 "$log"; return; fi
  fi
  # serve_node (cluster) or serve_solo (one node), stderr included: that is
  # where a crash's traceback is. A solo run's container is gone once it stops
  # (--rm), but journald kept its log.
  cmd="for c in serve_node serve_solo; do
  docker inspect \"\$c\" >/dev/null 2>&1 && exec docker logs $follow --tail 60 \"\$c\" 2>&1
done
out=\$(journalctl -q --no-pager -n 60 CONTAINER_NAME=serve_solo 2>/dev/null || true)
if [ -n \"\$out\" ]; then echo '(nothing serving now; the last solo run, from journald)'; printf '%s\\n' \"\$out\"
else echo 'no engine logs on this node (rack status)'; fi"
  if [ -z "$who" ]; then
    if [ "$IS_HEAD" = 1 ]; then bash -c "$cmd"; else ssh ${follow:+-t} "$HEAD_SSH" "$cmd"; fi
  else
    case " $WORKER_NAMES " in *" $who "*) ;; *) inv_has "$who" || die "no such node: $who (rack nodes)" ;; esac
    node_up "$who" || die "$who is unreachable over ssh ($(node_ssh "$who"))"
    ssh ${follow:+-t} "$(node_ssh "$who")" "$cmd"
  fi
}

