#!/usr/bin/env bash
# rack — drive the two-Spark serving cluster from anywhere.
#
#   rack fit  <hf-id>          will it fit? (asks HuggingFace, does the arithmetic)
#   rack pull <hf-id>          download + replicate to the worker + verify
#   rack new  <name> <hf-id>   scaffold a recipe you can edit
#   rack up   <recipe>         launch (solo or TP=2, from the recipe)
#   rack down                  stop everything
#   rack status                what's running, on both nodes
#   rack logs [-f]             head and worker logs
#   rack bench [label]         measure the running model
#   rack chat  <text>          one-shot completion against it
#   rack monitor up            telemetry for every node, one endpoint for the app
#
# Install:  ./rack install     (symlinks into ~/.local/bin or /usr/local/bin)
set -euo pipefail

# resolve through the symlink so the repo can live anywhere
SELF=${BASH_SOURCE[0]}
while [ -L "$SELF" ]; do SELF=$(readlink "$SELF"); done
ROOT=$(cd "$(dirname "$SELF")" && pwd)
cd "$ROOT"
[ -f .env ] && . ./.env
HEAD_IP=${HEAD_IP:-192.168.100.1}
HEAD_SSH=${HEAD_SSH:-spark-1}          # how a laptop reaches the head
HEAD_LABEL=${HEAD_LABEL:-$HEAD_SSH}
WORKER_SSH=${WORKER_SSH:-spark-2}
HF_CACHE=${HF_CACHE:-$HOME/dgx/hf}
IMAGE=${IMAGE:-dgx-spark-serve:dev}
API_PORT=${API_PORT:-8888}
API=http://127.0.0.1:$API_PORT/v1
TEMPLATE=${TEMPLATE:-recipes/TEMPLATE.env}   # what `rack new` scaffolds from

bold() { printf '\033[1m%s\033[0m\n' "$*"; }
dim()  { printf '\033[2m%s\033[0m\n' "$*"; }
die()  { printf '\033[31m%s\033[0m\n' "$*" >&2; exit 1; }
# Empty WORKER_SSH = a single-box site (cloud rental) — no worker exists, so
# don't pay a 5 s ssh timeout per command discovering that.
have_worker() { [ -n "$WORKER_SSH" ] || return 1; ssh -o BatchMode=yes -o ConnectTimeout=5 "$WORKER_SSH" true 2>/dev/null; }

# Are we typing ON the head, or driving it from a laptop? Both are supported,
# and the difference is not cosmetic: `docker ps` and `free` on a Mac describe
# the Mac. Detect once — docker present AND the fabric IP is one of ours.
is_head() {
  command -v docker >/dev/null 2>&1 || return 1
  { ip -o addr show 2>/dev/null || ifconfig 2>/dev/null; } | grep -q "$HEAD_IP"
}
IS_HEAD=0; is_head && IS_HEAD=1
run_on_head() {  # bash -c locally so quoting matches the ssh path exactly
  if [ "$IS_HEAD" = 1 ]; then bash -c "$1"; else ssh -n "$HEAD_SSH" "$1"; fi
}
# A path built from the laptop's $HOME is not the node's path. Keep $HOME
# literal so whichever shell finally runs it expands its own.
remote_path() { printf '%s' "${1/#$HOME/\$HOME}"; }

usage() {
  cat <<'EOF'
rack — drive the two-Spark serving cluster

  rack fit <hf-id>            will it fit? asks HuggingFace, does the arithmetic
  rack pull <hf-id>           download, replicate to the worker, verify shards
  rack models                 what's on disk, and where
  rack new <name> <hf-id>     scaffold recipes/<name>.env
  rack recipes                list recipes

  rack build [ngc|upstream|community]   build the image and ship it to the worker
  rack preflight              read-only health check, both nodes
  rack up <recipe>            launch — solo or TP=2, whichever the recipe says
  rack down                   stop serving on both nodes
  rack status                 containers, memory, API health
  rack logs [-f] [worker]     engine logs
  rack bench [label]          measure the running model
  rack chat <text>            one-shot completion
  rack net                    does the engine talk to the internet? verdict, both nodes
  rack scrub [--delete]       every trace a video run leaves: list, or wipe
  rack monitor up|down|status|token|logs
                              telemetry for every node behind one endpoint (docs/11-monitor.md)

Recipes live in recipes/. Config is .env. Everything is idempotent.
EOF
}

# ---------------------------------------------------------------- fit ------
cmd_fit() {
  local id=${1:?usage: rack fit <org/model>}
  bold "$id"
  python3 - "$id" "${USABLE_GB:-110}" <<'PY'
import json, sys, urllib.request
mid, usable = sys.argv[1], float(sys.argv[2])
def get(u):
    with urllib.request.urlopen(u, timeout=60) as r: return json.load(r)
try:
    api = get(f"https://huggingface.co/api/models/{mid}?blobs=true")
except Exception as e:
    sys.exit(f"  could not reach HuggingFace: {e}")
sib = api.get("siblings") or []
disk = sum(s.get("size") or 0 for s in sib)
shards = sum(1 for s in sib if s["rfilename"].endswith(".safetensors"))
st = (api.get("safetensors") or {})
total = st.get("total") or 0
gb = disk / 1e9
print(f"  download    {gb:,.1f} GB across {shards} shards")
if total:
    print(f"  parameters  {total/1e9:,.1f} B   ({disk*8/total:.2f} effective bpw)")
# active params, when the config exposes MoE geometry
try:
    c = get(f"https://huggingface.co/{mid}/raw/main/config.json")
    t = c.get("text_config", c)
    H, L = t.get("hidden_size"), t.get("num_hidden_layers")
    routed = t.get("n_routed_experts") or t.get("num_experts") or t.get("num_local_experts")
    if H and L and routed:
        top = (t.get("num_experts_per_tok") or t.get("num_experts_per_token") or 2)
        sh = (t.get("n_shared_experts") or t.get("num_shared_experts") or 0)
        mi = t.get("moe_intermediate_size") or t.get("intermediate_size")
        w = t.get("routed_expert_hidden_size") or H
        dense = t.get("first_k_dense_replace") or 0
        ml = L - dense
        act = (top + sh) * 3 * w * mi * ml
        print(f"  active/token ~{act/1e9:,.1f} B in experts  ({top} routed + {sh} shared of {routed})")
    ctx = t.get("max_position_embeddings")
    if ctx: print(f"  context     {ctx:,}")
except Exception:
    pass
print()
for nodes in (1, 2):
    budget = usable * nodes - 20
    ok = gb <= budget
    mark = "fits" if ok else "does not fit"
    print(f"  {nodes} node{'s' if nodes>1 else ' '}: {gb:,.0f} GB vs {budget:,.0f} GB budget "
          f"({usable:g} x {nodes} - 20 reserve)  ->  {mark}")
print("\n  budget assumes 20 GB held back for KV cache and runtime.")
print("  more at https://fits.bytebunkerlabs.ai")
PY
}

# --------------------------------------------------------------- pull ------
cmd_pull() {
  local id=${1:?usage: rack pull <org/model>}
  docker image inspect "$IMAGE" >/dev/null 2>&1 || die "image $IMAGE missing — run: rack build"
  bold "downloading $id"
  docker run --rm -v "$HF_CACHE:/root/.cache/huggingface" --entrypoint bash "$IMAGE" \
    -c "hf download '$id'"
  # The container downloads as root; anything it creates 600 (hub metadata
  # like trees/*.json) is unreadable to the host user and kills the rsync
  # replication mid-flight (measured: exit 23, and set -e then skips shard
  # verification — the worst part). Hand the tree back before syncing.
  docker run --rm -v "$HF_CACHE:/cache" --entrypoint chown "$IMAGE" \
    -R "$(id -u):$(id -g)" "/cache/hub/models--${id//\//--}"
  if have_worker; then
    bold "replicating to $WORKER_SSH over the fabric"
    "$ROOT/scripts/sync-model.sh" "$id"
  else
    dim "worker unreachable — skipping replication (single-node only until you sync)"
  fi
  cmd_verify "$id"
}

cmd_verify() {
  local id=${1:?} dir="models--${1//\//--}"
  bold "verifying shards"
  local script="
import json,glob,os,sys
g=glob.glob(os.path.expanduser('$HF_CACHE/hub/$dir/snapshots/*/'))
if not g: print('  MISSING on this node'); sys.exit(1)
p=g[0]; f=p+'model.safetensors.index.json'
if not os.path.exists(f): print('  single-file model, no index'); sys.exit(0)
i=json.load(open(f)); s=sorted(set(i['weight_map'].values()))
m=[x for x in s if not os.path.exists(p+x)]
print(f'  {len(s)} shards, {len(m)} missing')
sys.exit(1 if m else 0)"
  printf '  spark-1: '; python3 -c "$script" || die "incomplete on spark-1"
  if have_worker; then
    printf '  %s: ' "$WORKER_SSH"
    ssh -n "$WORKER_SSH" "python3 -c \"$script\"" || die "incomplete on $WORKER_SSH"
  fi
}

cmd_models() {
  bold "on disk"
  # The cache lives on the nodes. Asking the laptop's filesystem about it
  # answers a different question and the answer looks like "nothing cached".
  local out rc cache; cache=$(remote_path "$HF_CACHE")
  out=$(run_on_head "for d in $cache/hub/models--*; do [ -d \"\$d\" ] || continue;
        n=\${d##*/models--}; printf '  %-52s %s\n' \"\${n//--//}\" \"\$(du -sh \"\$d\" 2>/dev/null | cut -f1)\"; done") \
    && rc=0 || rc=$?
  if [ "$rc" -ne 0 ]; then
    dim "  UNKNOWN — could not read $HF_CACHE on $HEAD_LABEL"
  elif [ -n "$out" ]; then
    printf '%s\n' "$out"
  else
    dim "  nothing cached yet — try: rack pull <org/model>"
  fi
}

# Does this recipe want both nodes? Must ignore COMMENTED flags — the template
# carries `# --tensor-parallel-size 2` as a prompt, and a substring match on
# that sends a single-node model to the cluster launcher. Follows inheritance
# for the same reason recipe_model does: a variant may declare nothing itself.
is_tp2() {
  local f=$1 depth=${2:-0} parent
  [ "$depth" -gt 4 ] && return 1
  grep -qE '^[[:space:]]*--tensor-parallel-size[[:space:]]+2([[:space:]]|$)' "$f" && return 0
  parent=$(sed -n 's|^\. *\(recipes/[^ ]*\.env\).*|\1|p' "$f" | head -1)
  [ -n "$parent" ] && [ -e "$parent" ] && is_tp2 "$parent" $((depth + 1))
}

# MODEL= of a recipe, following `. recipes/parent.env` inheritance. A variant
# recipe (h3-spark2-sage) declares no MODEL of its own — that is the layering
# working, so read through to the parent rather than reporting nothing.
recipe_model() {
  local f=$1 depth=${2:-0} m parent
  [ "$depth" -gt 4 ] && { printf '(inheritance loop)'; return; }
  m=$(grep -m1 '^MODEL=' "$f" | cut -d= -f2- || true)
  [ -n "$m" ] && { printf '%s' "$m"; return; }
  parent=$(sed -n 's|^\. *\(recipes/[^ ]*\.env\).*|\1|p' "$f" | head -1)
  [ -n "$parent" ] && [ -e "$parent" ] && { recipe_model "$parent" $((depth + 1)); return; }
  printf '%s' '(none declared)'
}

cmd_recipes() {
  bold "recipes"
  local any=0 f
  for f in recipes/*.env; do
    [ -e "$f" ] || break
    [ "$f" = "$TEMPLATE" ] && continue                 # the scaffold, not a recipe
    any=1
    local m tp="solo"
    m=$(recipe_model "$f")
    is_tp2 "$f" && tp="TP=2"
    printf '  %-34s %-8s %s\n' "$(basename "$f" .env)" "$tp" "$m"
  done
  [ $any = 1 ] || dim "  none yet — try: rack new <name> <org/model>"
}

# ---------------------------------------------------------------- new ------
cmd_new() {
  local name=${1:?usage: rack new <name> <org/model>} id=${2:?usage: rack new <name> <org/model>}
  local f="recipes/$name.env"
  [ -e "$f" ] && die "$f already exists"
  [ -e "$TEMPLATE" ] || die "missing $TEMPLATE — the scaffold lives there, not in this script"

  # Header of our own, then the template from its first question down. The
  # template's preamble is guidance for the author and does not belong in a
  # recipe; docs/05-recipe-method.md is the long form.
  { printf '# %s — scaffolded %s by: rack new\n' "$name" "$(date +%Y-%m-%d)"
    printf '# Answer the questions in order. A flag with no reason is a flag\n'
    printf '# nobody can safely delete later.  docs/05-recipe-method.md\n\n'
    sed -n '/^# --- 1 FIT/,$p' "$TEMPLATE" \
      | sed -e "s|^MODEL=$|MODEL=$id|" \
            -e "s|^#     rack fit <org/model>$|#     rack fit $id|" \
            -e "s|^  --served-model-name$|  --served-model-name $name|" \
            -e "s|^  --port 8888$|  --port $API_PORT|"
  } > "$f"

  bold "wrote $f"
  dim "  1. rack fit $id      then record the verdict in the file"
  dim "  2. edit it, in order, top to bottom"
  dim "  3. rack up $name"
}

# --------------------------------------------------------- lifecycle ------
cmd_build()     { "$ROOT/scripts/build.sh" --profile "${1:-community}"; }
cmd_preflight() {
  bold "spark-1"; "$ROOT/scripts/preflight.sh" || true
  if have_worker; then
    echo; bold "$WORKER_SSH"
    ssh -n "$WORKER_SSH" "cd dgx/dgx-spark-serve && bash scripts/preflight.sh" || true
  fi
}

resolve_recipe() { # exact name, then a path, then a unique prefix — `rack up inkling`
  local r=$1                                  # should find inkling-small-nvfp4.env
  [ "recipes/$r.env" = "$TEMPLATE" ] && die "$TEMPLATE is the scaffold, not a recipe: rack new <name> <org/model>"
  [ -e "recipes/$r.env" ] && { printf 'recipes/%s.env' "$r"; return; }
  [ -e "$r" ] && { printf '%s' "$r"; return; }
  local g=(recipes/"$r"*.env) m=()
  local c; for c in "${g[@]}"; do [ "$c" = "$TEMPLATE" ] || m+=("$c"); done
  [ ${#m[@]} -gt 0 ] && [ -e "${m[0]}" ] || die "no such recipe: $r  (rack recipes)"
  [ ${#m[@]} -eq 1 ] || die "ambiguous: $r matches ${m[*]//recipes\//}"
  printf '%s' "${m[0]}"
}

cmd_up() {
  local r=${1:?usage: rack up <recipe>}; shift || true
  local f; f=$(resolve_recipe "$r")
  # A scaffolded recipe that was never finished would otherwise reach the engine
  # as a bare `--max-model-len --max-num-seqs` and fail somewhere less obvious.
  grep -q 'FILL_ME' "$f" && die "$f still has FILL_ME placeholders — answer question 4 (docs/05-recipe-method.md)"
  # TOPOLOGY (.env) is a SITE fact, not a model fact: on the two-Spark rack,
  # tensor parallelism means two machines (auto); on a rented multi-GPU box it
  # means N GPUs in ONE machine — TOPOLOGY=solo sends every recipe, TP
  # included, through launch-solo so the fabric machinery never engages.
  case "${TOPOLOGY:-auto}" in
    solo)
      bold "launching $f on this node (TOPOLOGY=solo)"
      "$ROOT/scripts/launch-solo.sh" "$f" "$@" ;;
    cluster)
      bold "launching $f across both nodes (TOPOLOGY=cluster)"
      "$ROOT/scripts/launch-cluster.sh" "$f" "$@" ;;
    auto)
      if is_tp2 "$f"; then
        bold "launching $f across both nodes"
        "$ROOT/scripts/launch-cluster.sh" "$f" "$@"
      else
        bold "launching $f on this node"
        "$ROOT/scripts/launch-solo.sh" "$f" "$@"
      fi ;;
    *) die "TOPOLOGY must be auto, solo, or cluster (got: $TOPOLOGY)" ;;
  esac
}

cmd_down() { "$ROOT/scripts/stop-cluster.sh"; }

# Report a node line, distinguishing "nothing running" from "could not look".
# Reporting the second as the first is how you launch a model on top of one
# that is already resident. `out`/`rc` come from node_probe.
node_probe() {   # node_probe <label> <remote-cmd> <filter> ; sets PROBE_OUT / PROBE_RC
  local label=$1 cmd=$2
  if [ "$label" = "$HEAD_LABEL" ]; then
    PROBE_OUT=$(run_on_head "$cmd" 2>/dev/null) && PROBE_RC=0 || PROBE_RC=$?
  else
    PROBE_OUT=$(ssh -n "$WORKER_SSH" "$cmd" 2>/dev/null) && PROBE_RC=0 || PROBE_RC=$?
  fi
}

cmd_status() {
  local n
  bold "containers"
  for n in "$HEAD_LABEL" "$WORKER_SSH"; do
    [ "$n" = "$WORKER_SSH" ] && { have_worker || { dim "  $n  unreachable over ssh"; continue; }; }
    node_probe "$n" "docker ps --format '{{.Names}}  {{.Status}}'"
    if [ "$PROBE_RC" -ne 0 ]; then
      dim "  $n  UNKNOWN — could not run docker there (not 'nothing serving')"
    elif printf '%s\n' "$PROBE_OUT" | grep -qE 'serve_'; then
      printf '%s\n' "$PROBE_OUT" | grep -E 'serve_' | sed "s/^/  $n  /"
    else
      dim "  $n  nothing serving"
    fi
  done

  echo; bold "memory"
  for n in "$HEAD_LABEL" "$WORKER_SSH"; do
    [ "$n" = "$WORKER_SSH" ] && { have_worker || continue; }
    node_probe "$n" "free -g | awk '/^Mem:/{printf \"%s GiB used, %s GiB available\", \$3, \$7}'"
    if [ "$PROBE_RC" -ne 0 ] || [ -z "$PROBE_OUT" ]; then
      dim "  $n  UNKNOWN — could not read free(1) there"
    else
      printf '  %s  %s\n' "$n" "$PROBE_OUT"
    fi
    # free(1) is truth on unified memory; nvidia-smi cannot see these bytes.
  done

  echo; bold "api"
  local m
  # Ask on the head — from a laptop, 127.0.0.1 is the laptop.
  if m=$(run_on_head "curl -s --max-time 5 http://127.0.0.1:$API_PORT/v1/models" 2>/dev/null) && [ -n "$m" ]; then
    printf '%s' "$m" | python3 -c "
import json,sys
try: d=json.load(sys.stdin)
except Exception: print('  not answering yet'); sys.exit()
ms=[x['id'] for x in d.get('data',[])]
print('  serving: ' + (', '.join(ms) if ms else 'no models'))" 2>/dev/null || dim "  not answering yet"
  else
    dim "  :$API_PORT on $HEAD_LABEL not answering (still loading, or nothing running)"
  fi

  echo; bold "monitor"
  HEAD_IP="$HEAD_IP" HEAD_LABEL="$HEAD_LABEL" WORKER_SSH="$WORKER_SSH" \
    "$ROOT/monitor/rack-monitor.sh" brief 2>/dev/null || dim "  unknown: rack monitor status"
}

cmd_logs() {
  local follow="" who="head"
  for a in "$@"; do case "$a" in -f|--follow) follow="-f";; worker|spark-2) who=worker;; esac; done
  if [ "$who" = worker ]; then
    have_worker || die "worker unreachable"
    ssh ${follow:+-t} "$WORKER_SSH" "docker logs $follow --tail 60 serve_node"
  else
    if [ -n "$follow" ]; then
      tail -f /tmp/*-launch.log 2>/dev/null \
        || docker logs -f --tail 60 serve_node 2>/dev/null \
        || docker logs -f --tail 60 serve_solo
    else
      docker logs --tail 60 serve_node 2>/dev/null \
        || docker logs --tail 60 serve_solo 2>/dev/null \
        || tail -60 /tmp/*-launch.log 2>/dev/null || dim "  no logs yet"
    fi
  fi
}

cmd_scrub() {
  bold "spark-1"
  bash "$ROOT/scripts/scrub.sh" "$@" || true
  if have_worker; then
    echo; bold "$WORKER_SSH"
    ssh -n "$WORKER_SSH" "cd dgx/dgx-spark-serve && bash scripts/scrub.sh $*" || true
  fi
}

cmd_net() {
  bold "spark-1"
  bash "$ROOT/scripts/netcheck.sh" || true
  if have_worker; then
    echo; bold "$WORKER_SSH"
    ssh -n "$WORKER_SSH" "cd dgx/dgx-spark-serve && bash scripts/netcheck.sh" || true
  fi
}

cmd_bench() {
  local label=${1:-$(date +%Y%m%d-%H%M)}
  local model
  model=$(curl -s --max-time 5 "$API/models" | python3 -c "
import json,sys
try: print(json.load(sys.stdin)['data'][0]['id'])
except Exception: pass" 2>/dev/null || true)
  [ -n "$model" ] || die "nothing serving on $API — rack up <recipe> first"
  bold "benchmarking $model"
  python3 "$ROOT/scripts/bench.py" --url "$API" --model "$model" --label "$label" "${@:2}"
}

cmd_chat() {
  [ $# -gt 0 ] || die 'usage: rack chat "your message"'
  local model
  model=$(curl -s --max-time 5 "$API/models" | python3 -c "
import json,sys
try: print(json.load(sys.stdin)['data'][0]['id'])
except Exception: pass" 2>/dev/null || true)
  [ -n "$model" ] || die "nothing serving on $API"
  python3 - "$API" "$model" "$*" <<'PY'
import json, sys, urllib.request
api, model, prompt = sys.argv[1], sys.argv[2], sys.argv[3]
body = {"model": model, "messages": [{"role": "user", "content": prompt}],
        "max_tokens": 1024, "stream": True}
req = urllib.request.Request(api + "/chat/completions", data=json.dumps(body).encode(),
                             headers={"Content-Type": "application/json"})
for raw in urllib.request.urlopen(req, timeout=600):
    line = raw.decode("utf-8", "replace").strip()
    if not line.startswith("data:"): continue
    p = line[5:].strip()
    if p == "[DONE]": break
    try: d = json.loads(p)
    except Exception: continue
    ch = (d.get("choices") or [{}])[0].get("delta") or {}
    sys.stdout.write(ch.get("content") or "")
    sys.stdout.flush()
print()
PY
}

cmd_install() {
  local dir
  for d in "$HOME/.local/bin" /usr/local/bin; do
    [ -d "$d" ] && [ -w "$d" ] && { dir=$d; break; }
  done
  [ -n "${dir:-}" ] || { mkdir -p "$HOME/.local/bin"; dir="$HOME/.local/bin"; }
  ln -sf "$ROOT/rack" "$dir/rack"
  bold "installed: $dir/rack -> $ROOT/rack"
  case ":$PATH:" in *":$dir:"*) dim "  ready — try: rack status" ;;
    *) dim "  add to PATH:  echo 'export PATH=\"$dir:\$PATH\"' >> ~/.bashrc && exec bash" ;;
  esac
}

case "${1:-}" in
  fit)       shift; cmd_fit "$@" ;;
  pull)      shift; cmd_pull "$@" ;;
  verify)    shift; cmd_verify "$@" ;;
  models)    shift; cmd_models "$@" ;;
  recipes)   shift; cmd_recipes "$@" ;;
  new)       shift; cmd_new "$@" ;;
  build)     shift; cmd_build "$@" ;;
  preflight) shift; cmd_preflight "$@" ;;
  up)        shift; cmd_up "$@" ;;
  down)      shift; cmd_down "$@" ;;
  status)    shift; cmd_status "$@" ;;
  logs)      shift; cmd_logs "$@" ;;
  net)       shift; cmd_net "$@" ;;
  scrub)     shift; cmd_scrub "$@" ;;
  bench)     shift; cmd_bench "$@" ;;
  chat)      shift; cmd_chat "$@" ;;
  monitor)   shift; HEAD_IP="$HEAD_IP" HEAD_LABEL="$HEAD_LABEL" WORKER_SSH="$WORKER_SSH" \
               exec "$ROOT/monitor/rack-monitor.sh" "$@" ;;
  install)   shift; cmd_install "$@" ;;
  ""|-h|--help|help) usage ;;
  *) die "unknown command: $1  (rack --help)" ;;
esac
