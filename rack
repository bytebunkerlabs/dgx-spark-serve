# The engine's API here (the port rack up recorded, else API_PORT), and the
# first model it serves, asked with the engine key.
engine_api() { local p; p=$(serving_get port); printf 'http://127.0.0.1:%s/v1' "${p:-$API_PORT}"; }
engine_model() {
  RACK_API_KEY_FILE=$ENGINE_KEY_FILE python3 -c '
import json,os,sys,urllib.request
key="none"
try: key=open(os.environ["RACK_API_KEY_FILE"]).read().strip() or "none"
except OSError: pass
req=urllib.request.Request(sys.argv[1]+"/models",headers={"Authorization":"Bearer "+key})
try: print(json.load(urllib.request.urlopen(req,timeout=5))["data"][0]["id"])
except Exception: pass' "$1"
}

cmd_bench() {
  local label=${1:-$(date +%Y%m%d-%H%M)}
  local model api; api=$(engine_api)
  model=$(engine_model "$api")
  [ -n "$model" ] || die "nothing serving on $api — rack up <recipe> first"
  bold "benchmarking $model"
  RACK_API_KEY_FILE=$ENGINE_KEY_FILE python3 "$ROOT/scripts/bench.py" --url "$api" --model "$model" --label "$label" "${@:2}"
}

cmd_chat() {
  [ $# -gt 0 ] || die 'usage: rack chat "your message"'
  local model api; api=$(engine_api)
  model=$(engine_model "$api")
  [ -n "$model" ] || die "nothing serving on $api"
  RACK_API_KEY_FILE=$ENGINE_KEY_FILE python3 - "$api" "$model" "$*" <<'PY'
import json, os, sys, urllib.request
api, model, prompt = sys.argv[1], sys.argv[2], sys.argv[3]
try: key = open(os.environ["RACK_API_KEY_FILE"]).read().strip() or "none"
except OSError: key = "none"
body = {"model": model, "messages": [{"role": "user", "content": prompt}],
        "max_tokens": 1024, "stream": True}
req = urllib.request.Request(api + "/chat/completions", data=json.dumps(body).encode(),
                             headers={"Content-Type": "application/json", "Authorization": "Bearer " + key})
for raw in urllib.request.urlopen(req, timeout=600):
    line = raw.decode("utf-8", "replace").strip()
    if not line.startswith("data:"): continue
    p = line[5:].strip()
    if p == "[DONE]": break
    try: d = json.loads(p)
    except Exception: continue
    ch = (d.get("choices") or [{}])[0].get("delta") or {}
    sys.stdout.write(ch.get("content") or "")
    sys.stdout.flush()
print()
PY
}

cmd_install() {
  local dir
  for d in "$HOME/.local/bin" /usr/local/bin; do
    [ -d "$d" ] && [ -w "$d" ] && { dir=$d; break; }
  done
  [ -n "${dir:-}" ] || { mkdir -p "$HOME/.local/bin"; dir="$HOME/.local/bin"; }
  ln -sf "$ROOT/rack" "$dir/rack"
  bold "installed: $dir/rack -> $ROOT/rack"
  case ":$PATH:" in *":$dir:"*) dim "  ready — try: rack status" ;;
    *) dim "  add to PATH:  echo 'export PATH=\"$dir:\$PATH\"' >> ~/.bashrc && exec bash" ;;
  esac
}

# --on <node>: the same command on that machine of the inventory, over ssh.
# Taken out before any command parses its arguments.
ON_NODE="" ARGS=()
while [ $# -gt 0 ]; do
  case "$1" in
    --on) [ -n "${2:-}" ] || die "--on needs a node name  (rack nodes)"; ON_NODE=$2; shift 2 ;;
    --on=*) ON_NODE=${1#--on=}; shift ;;
    *) ARGS+=("$1"); shift ;;
  esac
done
set -- ${ARGS[@]+"${ARGS[@]}"}
if [ -n "$ON_NODE" ]; then
  case "${1:-}" in
    init|nodes|install|""|-h|--help|help) die "rack ${1:-} works on this machine only: no --on" ;;
  esac
  inv_has "$ON_NODE" || die "no such node: $ON_NODE  (rack nodes)"
  on_plat=$(inv_get "$ON_NODE" NODE_PLATFORM) on_plan=0
  for a in "$@"; do [ "$a" = --plan ] && on_plan=1; done
  for a in "$@"; do
    case "$a" in
      --dgx|--linux|--windows|--mac)
        [ "$on_plan" = 1 ] || [ -z "$on_plat" ] || [ "${a#--}" = "$on_plat" ] \
          || die "$ON_NODE is $(platform_title "$on_plat"); $a needs $(platform_title "${a#--}")" ;;
    esac
  done
  run_on_node "$ON_NODE" "$@" || true        # returns only when the node is this machine
fi

case "${1:-}" in
  platform)  shift; cmd_platform "$@" ;;
  version|--version) shift; cmd_version "$@" ;;
  init)      shift; cmd_init "$@" ;;
  nodes)     shift; cmd_nodes "$@" ;;
  fit)       shift; cmd_fit "$@" ;;
  pull)      shift; cmd_pull "$@" ;;
  verify)    shift; cmd_verify "$@" ;;
  models)    shift; cmd_models "$@" ;;
  recipes)   shift; cmd_recipes "$@" ;;
  new)       shift; cmd_new "$@" ;;
  build)     shift; cmd_build "$@" ;;
  preflight) shift; cmd_preflight "$@" ;;
  up)        shift; cmd_up "$@" ;;
  down)      shift; cmd_down "$@" ;;
  status)    shift; cmd_status "$@" ;;
  logs)      shift; cmd_logs "$@" ;;
  net)       shift; cmd_net "$@" ;;
  scrub)     shift; cmd_scrub "$@" ;;
  bench)     shift; cmd_bench "$@" ;;
  chat)      shift; cmd_chat "$@" ;;
  monitor)   shift; monitor_env exec "$ROOT/monitor/rack-monitor.sh" "$@" ;;
  install)   shift; cmd_install "$@" ;;
  ""|-h|--help|help) usage ;;
  *) die "unknown command: $1  (rack --help)" ;;
esac
