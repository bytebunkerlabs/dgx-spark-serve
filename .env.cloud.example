# dgx-spark-serve on a RENTED GPU BOX — copy to .env on the cloud machine.
#
# The layering rule is the portability plan: recipes hold model truth, .env
# holds site truth. Moving to new hardware = this file + re-answering the
# recipe questions that are site-local (1, 2, 6, parts of 4 — see
# docs/07-operators-manual.md Part 11). Recipes' access/dialect answers
# (3, 5) port unchanged.
#
# This profile assumes ONE box, one or more GPUs, discrete GPU memory
# (HBM/GDDR — not unified). Verified against nothing yet: it is a starting
# point, and question 8 (bench, commit the number) still applies on day one.

# --- topology ----------------------------------------------------------------
TOPOLOGY=solo                # THE cloud line: --tensor-parallel-size N now
                             # means N GPUs in THIS box, routed through
                             # launch-solo. The fabric machinery never engages.
WORKER_SSH=                  # empty = no worker exists; rack skips every
                             # worker probe instead of paying 5 s timeouts
HEAD_SSH=localhost           # you are the head; rack runs everything locally
                             # once docker is present (is_head detection)

# --- fit arithmetic ----------------------------------------------------------
# Set to the box's TOTAL usable GPU memory across all GPUs, minus driver
# overhead. Read `nvidia-smi --query-gpu=memory.total --format=csv`.
#   GB300 (288 GB HBM3e/GPU):        1 GPU ~ 280;  4 GPUs ~ 1120
#   RTX Pro 6000 Blackwell (96 GB):  1 GPU ~ 92;   8 GPUs ~ 736
# Then read rack fit's 1-node verdict and ignore the 2-node line.
USABLE_GB=92

# --- image -------------------------------------------------------------------
# No `rack build` needed off-Spark: the official multi-arch image serves both
# aarch64 (GB300/Grace) and x86_64 (typical RTX Pro hosts). PIN THE TAG — the
# recipe method's question 2 still applies: does a build that supports YOUR
# model exist for YOUR arch, as of which date.
IMAGE=vllm/vllm-openai:v0.26.0

# --- paths / serving ---------------------------------------------------------
HF_CACHE=$HOME/dgx/hf        # keep the path convention — recipes and scripts
                             # assume it; on a fresh box: mkdir -p ~/dgx/hf
API_PORT=8888

# --- what is deliberately ABSENT here ----------------------------------------
# HEAD_IP/WORKER_IP/FABRIC_IF/FABRIC_IF2/RDMA_DEV/IB_HCAS/MASTER_PORT — fabric
# facts. A single box has no fabric; TOPOLOGY=solo means nothing reads them.
#
# Memory instrument INVERTS off unified memory: on this hardware nvidia-smi is
# the truth for GPU memory and free(1) describes host RAM. rack status's
# memory section reports host RAM here — read nvidia-smi for the number that
# gates model fit. (The reverse of every Spark doc in this repo.)
